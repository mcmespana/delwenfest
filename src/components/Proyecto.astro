---
import Placeholder from './Placeholder.astro';
import { PROJECT_BUDGET, PROJECT_CHAPTERS, PROJECT_QUOTE, LOREM } from '../data/delwende';
import { CAUSE } from '../data/event';
---

<section id="proyecto" class="relative overflow-hidden bg-night text-cream" data-draft data-project>
  <div class="grain pointer-events-none absolute inset-0"></div>

  <div class="relative mx-auto max-w-7xl px-4 pt-28 sm:px-8 md:pt-36">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="eyebrow text-gold" data-reveal="up">✦ El proyecto en detalle</p>
        <h2 class="section-title mt-3" data-split>Atakpamé<br /><span class="text-gold">paso a paso</span></h2>
      </div>
      <p class="max-w-md text-lg leading-snug text-cream/75" data-reveal="up">{CAUSE.project} · {CAUSE.place}. {LOREM.short}</p>
    </div>
  </div>

  <!-- Capítulos: scroll horizontal fijado en escritorio, carrusel en móvil -->
  <div class="relative mt-14 md:mt-20" data-chapters-pin>
    <div
      class="no-scrollbar flex snap-x snap-mandatory gap-5 overflow-x-auto px-4 pb-6 sm:px-8 md:w-max md:snap-none md:overflow-visible md:pb-0 md:pl-[max(2rem,calc((100vw-80rem)/2+2rem))] md:pr-[20vw]"
      data-chapters
      data-lenis-prevent-touch
    >
      {
        PROJECT_CHAPTERS.map((c) => (
          <article class="w-[84vw] shrink-0 snap-center sm:w-[60vw] md:w-[min(46vw,620px)]" data-chapter>
            <Placeholder dark label={c.photo} class="aspect-[16/10] w-full" />
            <p class="eyebrow mt-6 text-gold">{c.kicker}</p>
            <h3 class="font-display mt-2 text-[clamp(1.8rem,3vw,2.6rem)] leading-[0.95] uppercase">{c.title}</h3>
            <p class="mt-3 max-w-lg text-lg leading-snug text-cream/70">{c.text}</p>
          </article>
        ))
      }
    </div>
    <div class="mx-auto mt-6 hidden h-1 max-w-7xl overflow-hidden rounded-full bg-cream/10 md:mx-8 md:block xl:mx-auto">
      <div class="h-full origin-left scale-x-0 bg-[linear-gradient(90deg,#8cc63f,#f5b50b,#f87341)]" data-chapters-bar></div>
    </div>
  </div>

  <div class="relative mx-auto grid max-w-7xl gap-6 px-4 py-24 sm:px-8 md:grid-cols-2 md:py-32">
    <!-- A qué se destina -->
    <div class="rounded-[2rem] border border-cream/15 bg-cream/[0.04] p-7 sm:p-9" data-reveal="up">
      <p class="eyebrow text-gold">¿A qué se destina?</p>
      <p class="mt-2 text-cream/60">Reparto del presupuesto del proyecto · datos pendientes</p>
      <ul class="mt-7 flex flex-col gap-5">
        {
          PROJECT_BUDGET.map((b, i) => (
            <li>
              <div class="flex items-baseline justify-between gap-4">
                <span class="font-semibold">{b.label}</span>
                <span class="font-display text-xl text-gold">{b.pct}</span>
              </div>
              <div class="mt-2 h-3 overflow-hidden rounded-full bg-cream/10">
                <div
                  class="h-full w-full origin-left rounded-full [background-image:repeating-linear-gradient(45deg,rgba(245,181,11,.55)_0_6px,rgba(245,181,11,.25)_6px_12px)]"
                  style={`transform: scaleX(${0.25 + ((PROJECT_BUDGET.length - i) / PROJECT_BUDGET.length) * 0.5})`}
                  data-budget-bar
                />
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Testimonio -->
    <figure class="relative flex flex-col justify-between gap-8 overflow-hidden rounded-[2rem] bg-gold p-7 text-ink sm:p-9" data-reveal="up">
      <span class="font-display absolute -top-6 right-4 text-[11rem] leading-none text-ink/10" aria-hidden="true">“</span>
      <blockquote class="font-display relative text-[clamp(1.5rem,2.6vw,2.2rem)] leading-[1.1] uppercase">{PROJECT_QUOTE.text}</blockquote>
      <figcaption class="relative flex items-center gap-4">
        <Placeholder label="Retrato" class="size-16 shrink-0 !rounded-full [&_figcaption]:hidden" />
        <span>
          <span class="block font-display text-lg uppercase">{PROJECT_QUOTE.author}</span>
          <span class="text-sm font-semibold opacity-70">{PROJECT_QUOTE.role}</span>
        </span>
      </figcaption>
    </figure>
  </div>
</section>

<script>
  import { gsap, reduceMotion } from '../scripts/motion';

  const visible = document.documentElement.classList.contains('show-drafts');
  const mm = gsap.matchMedia();
  if (visible) mm.add('(min-width: 768px) and (prefers-reduced-motion: no-preference)', () => {
    const track = document.querySelector<HTMLElement>('[data-chapters]')!;
    const distance = () => track.scrollWidth - window.innerWidth;
    gsap.to(track, {
      x: () => -distance(),
      ease: 'none',
      scrollTrigger: {
        trigger: '[data-chapters-pin]',
        start: 'top 12%',
        end: () => `+=${distance()}`,
        pin: true,
        refreshPriority: 1,
        scrub: 0.6,
        invalidateOnRefresh: true,
        onUpdate: (self) => gsap.set('[data-chapters-bar]', { scaleX: self.progress }),
      },
    });
  });

  if (!reduceMotion) {
    gsap.utils.toArray<HTMLElement>('[data-budget-bar]').forEach((bar) => {
      gsap.from(bar, { scaleX: 0, duration: 1.4, ease: 'expo.out', scrollTrigger: { trigger: bar, start: 'top 90%', once: true } });
    });
  }
</script>
