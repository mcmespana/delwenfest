---
import { Image } from 'astro:assets';
import Placeholder from './Placeholder.astro';
import delwendeLogo from '../assets/partners/delwende.webp';
import { ONGD, DELWENDE_URLS } from '../data/delwende';

const areaColors = ['bg-coral', 'bg-teal', 'bg-lime'];
---

<section id="delwende" class="relative overflow-hidden bg-cream px-4 py-28 sm:px-8 md:py-36">
  <div class="paper-texture !opacity-40"></div>
  <div class="relative mx-auto max-w-7xl">
    <div class="grid gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-20">
      <div>
        <p class="eyebrow text-forest" data-reveal="up">La ONGD de la Familia Consolación</p>
        <h2 class="section-title mt-3 !text-[clamp(3rem,7.4vw,7rem)]" data-split>
          ONGD<br /><span class="text-pop [--pop:var(--color-lime)]">Delwende</span>
        </h2>

        <div class="sticker mt-8 inline-flex rounded-[1.5rem] bg-white px-5 py-4" data-reveal="up">
          <Image src={delwendeLogo} alt="Delwende, al servicio de la vida" widths={[300, 600]} sizes="300px" class="h-auto w-60 sm:w-72" />
        </div>

        <p class="mt-8 text-lg leading-relaxed font-medium sm:text-xl" data-reveal="up">{ONGD.origin}</p>
        <p class="mt-4 text-lg leading-relaxed font-medium sm:text-xl" data-reveal="up">{ONGD.how}</p>

        <a href={DELWENDE_URLS.identity} target="_blank" rel="noopener" class="btn btn-cream mt-8 !text-base" data-reveal="up">Conoce más en delwende.es <svg viewBox="0 0 24 24" class="inline size-[0.9em] -translate-y-px" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"></path></svg></a>
      </div>

      <div class="flex flex-col gap-6">
        <blockquote class="sticker rounded-[2rem] bg-ink p-7 text-cream sm:p-9" data-reveal="up">
          <p class="eyebrow text-gold">Nuestra misión</p>
          <p class="font-display mt-3 text-[clamp(1.4rem,2.4vw,1.9rem)] leading-[1.1] uppercase">{ONGD.mission}</p>
        </blockquote>
        <div class="grid grid-cols-2 gap-4" data-reveal="up">
          <Placeholder label={ONGD.photos[0]} class="aspect-[4/5] w-full rotate-[-2deg]" />
          <Placeholder label={ONGD.photos[1]} class="aspect-[4/5] w-full translate-y-6 rotate-[2deg]" />
        </div>
      </div>
    </div>

    <!-- Ámbitos -->
    <ul class="mt-20 grid gap-5 md:grid-cols-3">
      {
        ONGD.areas.map((a, i) => (
          <li class={`sticker rounded-[1.75rem] p-6 sm:p-7 ${areaColors[i]}`} data-reveal="up">
            <h3 class="font-display text-2xl leading-none uppercase sm:text-3xl">{a.title}</h3>
            <p class="mt-3 text-lg leading-snug font-semibold">{a.text}</p>
          </li>
        ))
      }
    </ul>

    <!-- Cifras -->
    <dl class="mt-6 grid grid-cols-2 gap-4 lg:grid-cols-4">
      {
        ONGD.facts.map((f) => (
          <div class="sticker rounded-[1.5rem] bg-gold p-5 sm:p-6" data-reveal="up">
            <dt class="sr-only">{f.label}</dt>
            <dd>
              <p class="font-display text-[clamp(2.2rem,4.4vw,3.4rem)] leading-none tabular-nums">{f.value}</p>
              <p class="mt-1.5 leading-tight font-semibold">{f.label}</p>
            </dd>
          </div>
        ))
      }
    </dl>
    <p class="mt-4 text-sm text-ink/60">Datos de 2023 · Informe de Transparencia de Fundación Lealtad, que acredita a Delwende con el sello «Dona con confianza».</p>
  </div>
</section>
