---
import { Image } from 'astro:assets';
import badge from '../assets/brand/badge-consolacion.webp';
import { VENUE, DIRECTIONS, EVENT } from '../data/event';
---

<section id="lugar" class="relative overflow-hidden bg-mint px-4 py-28 sm:px-8 md:py-36">
  <div class="paper-texture"></div>
  <div class="relative mx-auto max-w-7xl">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="eyebrow text-forest" data-reveal="up">¿Dónde y cuándo?</p>
        <h2 class="section-title mt-3" data-split>Nos vemos<br />en Consola</h2>
      </div>
      <div class="relative w-36 shrink-0 self-end sm:w-48" data-reveal="pop">
        <Image src={badge} alt="Consolación Castellón" widths={[300, 500]} sizes="200px" class="animate-wiggle h-auto w-full drop-shadow-[5px_6px_0_rgba(36,33,30,.3)]" />
      </div>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-[0.85fr_1.15fr] lg:gap-8">
      <div class="flex flex-col gap-6">
        <div class="sticker rounded-[2rem] bg-coral p-7 sm:p-8" data-reveal="up">
          <p class="eyebrow">¿Dónde?</p>
          <h3 class="font-display mt-2 text-[clamp(2rem,3.6vw,2.8rem)] leading-[0.95] uppercase">{VENUE.name}</h3>
          <p class="mt-3 text-lg font-semibold sm:text-xl">{VENUE.street}<br />{VENUE.city}</p>
        </div>

        <div class="sticker relative overflow-hidden rounded-[2rem] bg-ink p-7 text-cream sm:p-8" data-reveal="up">
          <p class="eyebrow text-gold">⚠ Ojo con la entrada</p>
          <p class="font-display mt-2 text-[clamp(1.8rem,3.2vw,2.5rem)] leading-[0.95] uppercase">{VENUE.entrance}</p>
          <p class="mt-2 text-lg font-semibold text-cream/80">({VENUE.entranceHint})</p>
          <svg viewBox="0 0 100 60" class="absolute -right-2 -bottom-1 w-28 text-gold" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-arrow>
            <path d="M5 50 C 30 50, 55 40, 80 15"></path>
            <path d="M62 14 L 81 13 L 79 32"></path>
          </svg>
        </div>

        <div class="sticker rounded-[2rem] bg-gold p-7 sm:p-8" data-reveal="up">
          <p class="eyebrow">¿Cuándo?</p>
          <div class="mt-2 flex items-center gap-5">
            <div class="sticker grid w-20 shrink-0 overflow-hidden rounded-2xl bg-cream text-center !shadow-[var(--shadow-hard-sm)]">
              <span class="bg-red pt-1 font-display text-sm text-cream uppercase">Oct</span>
              <span class="font-display text-4xl leading-tight">30</span>
            </div>
            <p class="font-display text-[clamp(1.6rem,3vw,2.2rem)] leading-[0.95] uppercase">
              {EVENT.weekday} 30 de octubre<br /><span class="text-red">{EVENT.timeLabel}</span>
            </p>
          </div>
        </div>
      </div>

      <div class="sticker relative min-h-[420px] overflow-hidden rounded-[2rem] bg-cream lg:min-h-0" data-reveal="up">
        <div
          id="mapa"
          class="absolute inset-0 z-0"
          role="region"
          aria-label="Mapa de la entrada al festival"
          data-map
          data-lat={VENUE.entranceCoords[0]}
          data-lng={VENUE.entranceCoords[1]}
          data-school-lat={VENUE.schoolCoords[0]}
          data-school-lng={VENUE.schoolCoords[1]}
          data-shop-lat={VENUE.carrefourCoords[0]}
          data-shop-lng={VENUE.carrefourCoords[1]}
        >
        </div>
        <div class="pointer-events-none absolute inset-x-3 bottom-3 z-[500] flex flex-wrap justify-center gap-2 sm:inset-x-5 sm:bottom-5 sm:gap-3">
          <a href={DIRECTIONS.google} target="_blank" rel="noopener" class="btn btn-gold pointer-events-auto !px-4 !text-sm sm:!text-base">Google Maps</a>
          <a href={DIRECTIONS.apple} target="_blank" rel="noopener" class="btn btn-cream pointer-events-auto !px-4 !text-sm sm:!text-base">Apple Maps</a>
          <a href={DIRECTIONS.waze} target="_blank" rel="noopener" class="btn btn-cream pointer-events-auto !px-4 !text-sm sm:!text-base">Waze</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  @import 'leaflet/dist/leaflet.css';
  .leaflet-container {
    font-family: var(--font-sans);
    background: #e8efe9;
  }
  .leaflet-tile-pane {
    filter: saturate(0.75) contrast(1.05);
  }
  .delwen-pin {
    position: relative;
  }
  .delwen-pin .ring {
    position: absolute;
    left: 50%;
    top: 100%;
    width: 28px;
    height: 28px;
    margin: -14px 0 0 -14px;
    border-radius: 999px;
    background: rgba(247, 54, 58, 0.45);
    animation: pulse-ring 2s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }
  .delwen-pin .label {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 6px);
    transform: translateX(-50%);
    white-space: nowrap;
    background: #24211e;
    color: #f5b50b;
    border-radius: 999px;
    padding: 6px 12px 4px;
    font-family: 'Chau Philomene One', sans-serif;
    font-size: 14px;
    text-transform: uppercase;
    box-shadow: 3px 3px 0 #f5b50b;
  }
  .shop-pin {
    background: #fff7e8;
    border: 2.5px solid #24211e;
    border-radius: 999px;
    padding: 4px 10px 2px;
    font-family: 'Chau Philomene One', sans-serif;
    font-size: 12px;
    white-space: nowrap;
    box-shadow: 2px 2px 0 #24211e;
    transform: translate(18px, -50%);
    display: inline-block;
  }
</style>

<script>
  import { gsap, reduceMotion } from '../scripts/motion';

  const el = document.querySelector<HTMLElement>('[data-map]')!;
  const n = (k: string) => Number(el.dataset[k]);

  let loaded = false;
  async function initMap() {
    if (loaded) return;
    loaded = true;
    const L = (await import('leaflet')).default;
    const entrance: [number, number] = [n('lat'), n('lng')];
    const school: [number, number] = [n('schoolLat'), n('schoolLng')];
    const shop: [number, number] = [n('shopLat'), n('shopLng')];

    const map = L.map(el, { scrollWheelZoom: false, zoomControl: true, attributionControl: true }).setView([39.9935, -0.036], 14);
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
    }).addTo(map);

    const pinSvg = `<svg width="44" height="56" viewBox="0 0 24 30"><path d="M12 1a10 10 0 0 0-10 10c0 7.5 10 18 10 18s10-10.5 10-18A10 10 0 0 0 12 1Z" fill="#f7363a" stroke="#24211e" stroke-width="1.6"/><circle cx="12" cy="11" r="4" fill="#fff7e8" stroke="#24211e" stroke-width="1.4"/></svg>`;
    L.marker(entrance, {
      icon: L.divIcon({
        className: 'delwen-pin',
        html: `<span class="ring"></span><span class="label">Entrada DelwenFest</span>${pinSvg}`,
        iconSize: [44, 56],
        iconAnchor: [22, 56],
      }),
      title: 'Entrada por C/ Mª Rosa Molas',
    }).addTo(map);
    L.marker(shop, { icon: L.divIcon({ className: '', html: '<span class="shop-pin">Carrefour Express</span>', iconSize: [0, 0] }), interactive: false }).addTo(map);
    L.circle(school, { radius: 70, color: '#1d8462', weight: 2, dashArray: '6 6', fillColor: '#8cc63f', fillOpacity: 0.18 }).addTo(map);

    if (reduceMotion) map.setView(entrance, 17);
    else setTimeout(() => map.flyTo(entrance, 17, { duration: 2.6 }), 300);
  }

  new IntersectionObserver(
    (entries, obs) => {
      if (entries.some((e) => e.isIntersecting)) {
        initMap();
        obs.disconnect();
      }
    },
    { rootMargin: '200px' },
  ).observe(el);

  if (!reduceMotion) {
    gsap.fromTo('[data-arrow]', { x: -6, y: 6 }, { x: 4, y: -4, duration: 0.7, ease: 'sine.inOut', yoyo: true, repeat: -1 });
  }
</script>
