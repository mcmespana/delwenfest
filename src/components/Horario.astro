---
import { Image } from 'astro:assets';
import rodhel from '../assets/brand/rodhel-show.webp';
import { SCHEDULE, EVENT } from '../data/event';

const toneTxt: Record<string, string> = { red: 'text-red', coral: 'text-coral', amber: 'text-amber' };
---

<section id="horario" class="relative overflow-hidden bg-cream px-4 py-28 sm:px-8 md:py-36">
  <div class="paper-texture !opacity-40"></div>
  <div class="relative mx-auto grid max-w-7xl gap-14 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20">
    <!-- Columna fija con el reloj grande -->
    <div class="lg:sticky lg:top-28 lg:h-fit">
      <p class="eyebrow text-red" data-reveal="up">{EVENT.weekday} 30 de octubre</p>
      <h2 class="section-title mt-3 !text-[clamp(3.4rem,9vw,7.2rem)]" data-split>Horario</h2>
      <p class="mt-5 inline-flex items-center gap-2 rounded-full bg-ink px-4 pt-2 pb-1.5 font-display text-sm tracking-wide text-gold uppercase" data-reveal="up">
        <span class="relative flex size-2.5"><span class="absolute inline-flex size-full animate-ping rounded-full bg-gold opacity-75"></span><span class="relative inline-flex size-2.5 rounded-full bg-gold"></span></span>
        Horario actualizado
      </p>

      <div class="sticker mt-8 hidden overflow-hidden rounded-[2rem] bg-ink p-8 text-cream lg:block" data-reveal="up">
        <p class="eyebrow text-cream/60" data-clock-kicker>{SCHEDULE[0].kicker}</p>
        <p class="font-display mt-2 text-[8.5rem] leading-[0.8] tabular-nums" data-clock>{SCHEDULE[0].time}</p>
        <p class="font-display mt-4 text-4xl text-gold uppercase" data-clock-title>{SCHEDULE[0].title}</p>
        <div class="mt-6 h-2 overflow-hidden rounded-full bg-cream/15">
          <div class="h-full origin-left scale-x-0 rounded-full bg-[linear-gradient(90deg,#f7363a,#f87341,#ffae34)]" data-clock-bar></div>
        </div>
      </div>

      <div class="mt-8" data-reveal="up">
        <button type="button" class="btn btn-gold" data-remind>
          <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8a6 6 0 1 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path></svg>
          Guardar recordatorio
        </button>
      </div>
    </div>

    <!-- Lista de franjas -->
    <div class="relative">
      <div class="absolute top-6 bottom-6 left-[1.65rem] w-1.5 rounded-full bg-ink/10 sm:left-[2.15rem]" aria-hidden="true">
        <div class="h-full w-full origin-top scale-y-0 rounded-full bg-[linear-gradient(180deg,#f7363a,#f87341,#ffae34)]" data-line></div>
      </div>
      <ol class="relative flex flex-col gap-6 sm:gap-8">
        {
          SCHEDULE.map((s, i) => (
            <li
              class="group relative pl-16 sm:pl-24"
              data-slot
              data-time={s.time}
              data-title={s.title}
              data-kicker={s.kicker}
              data-index={i}
            >
              <span
                class="sticker absolute top-6 left-0 grid size-14 place-items-center rounded-full bg-cream font-display text-lg !shadow-[var(--shadow-hard-sm)] transition-colors duration-300 group-data-[on=true]:bg-gold sm:size-[4.3rem] sm:text-xl"
                data-dot
              >
                {String(i + 1).padStart(2, '0')}
              </span>
              <div class={`sticker relative overflow-visible rounded-[1.75rem] p-5 text-ink sm:p-7 tone-${s.tone}`} data-slot-card>
                <span class="absolute -top-3 right-5 hidden rounded-full border-2 border-ink bg-ink px-3 pt-1 pb-0.5 font-display text-xs tracking-widest text-gold uppercase" data-now>
                  ● Ahora
                </span>
                <div class="flex items-center gap-4 sm:gap-6">
                  <p class="font-display text-[clamp(2.6rem,6vw,4.4rem)] leading-none tabular-nums text-ink">{s.time}</p>
                  <div class="min-w-0 flex-1">
                    <p class="eyebrow !text-xs text-ink/70 sm:!text-sm">{s.kicker}</p>
                    {s.title === 'Rodhel Show' ? (
                      <p class="mt-1 flex items-center gap-2">
                        <Image src={rodhel} alt="Rodhel Show" widths={[300, 600]} sizes="220px" class="h-auto w-[min(52vw,220px)] -rotate-3 drop-shadow-[3px_3px_0_rgba(36,33,30,.6)]" />
                        <span class="font-display text-3xl text-cream [-webkit-text-stroke:1.5px_#24211e] [paint-order:stroke_fill]">DJ</span>
                      </p>
                    ) : (
                      <h3 class="font-display mt-1 text-[clamp(1.8rem,4vw,2.8rem)] leading-[0.95] uppercase">{s.title}</h3>
                    )}
                  </div>
                  {s.img && (
                    <Image
                      src={s.img}
                      alt=""
                      widths={[160, 320]}
                      sizes="110px"
                      class="pointer-events-none -my-8 hidden h-auto w-24 shrink-0 rotate-6 drop-shadow-[4px_6px_0_rgba(36,33,30,.25)] transition-transform duration-500 ease-[var(--ease-bounce)] group-hover:scale-125 group-hover:-rotate-6 sm:block md:w-28"
                    />
                  )}
                </div>
                <p class="mt-3 max-w-xl text-base leading-snug font-semibold text-ink/85 sm:text-lg">{s.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <p class="mt-10 pl-16 text-lg leading-snug font-semibold sm:pl-24" data-reveal="up">
        Y durante el festival: <span class="font-display uppercase">juegos, hinchables, toro mecánico y food trucks</span> con comida y bebida.
      </p>
    </div>
  </div>
</section>

<script>
  import { gsap, ScrollTrigger, reduceMotion } from '../scripts/motion';

  const slots = gsap.utils.toArray<HTMLElement>('[data-slot]');
  const clock = document.querySelector<HTMLElement>('[data-clock]');
  const clockTitle = document.querySelector<HTMLElement>('[data-clock-title]');
  const clockKicker = document.querySelector<HTMLElement>('[data-clock-kicker]');
  const clockBar = document.querySelector<HTMLElement>('[data-clock-bar]');
  let active = -1;

  function activate(i: number) {
    if (i === active || !clock) return;
    active = i;
    const s = slots[i].dataset;
    slots.forEach((el, j) => (el.dataset.on = String(j <= i)));
    if (reduceMotion) {
      clock.textContent = s.time!;
      clockTitle!.textContent = s.title!;
      clockKicker!.textContent = s.kicker!;
      return;
    }
    gsap
      .timeline()
      .to([clock, clockTitle, clockKicker], { yPercent: -40, opacity: 0, duration: 0.18, ease: 'power2.in' })
      .add(() => {
        clock.textContent = s.time!;
        clockTitle!.textContent = s.title!;
        clockKicker!.textContent = s.kicker!;
      })
      .fromTo([clock, clockTitle, clockKicker], { yPercent: 40, opacity: 0 }, { yPercent: 0, opacity: 1, duration: 0.5, stagger: 0.05, ease: 'back.out(2)' });
    gsap.to(clockBar, { scaleX: (i + 1) / slots.length, duration: 0.6, ease: 'power3.out' });
  }

  slots.forEach((el, i) => {
    ScrollTrigger.create({
      trigger: el,
      start: 'top 60%',
      end: 'bottom 60%',
      onEnter: () => activate(i),
      onEnterBack: () => activate(i),
    });
  });

  if (!reduceMotion) {
    gsap.to('[data-line]', {
      scaleY: 1,
      ease: 'none',
      scrollTrigger: { trigger: '[data-line]', start: 'top 60%', end: 'bottom 60%', scrub: 0.4 },
    });
    slots.forEach((el, i) => {
      gsap.from(el.querySelector('[data-slot-card]'), {
        x: i % 2 ? 80 : -80,
        rotate: i % 2 ? 4 : -4,
        opacity: 0,
        duration: 0.9,
        ease: 'back.out(1.4)',
        scrollTrigger: { trigger: el, start: 'top 88%', once: true },
      });
      gsap.from(el.querySelector('[data-dot]'), { scale: 0, rotate: -180, duration: 0.7, ease: 'back.out(2.4)', scrollTrigger: { trigger: el, start: 'top 85%', once: true } });
    });
  }

  // Modo “en directo”: marca la franja actual el día del evento (hora de Madrid)
  function markNow() {
    const parts = new Intl.DateTimeFormat('es-ES', {
      timeZone: 'Europe/Madrid',
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
    }).formatToParts(new Date());
    const get = (t: string) => parts.find((p) => p.type === t)?.value ?? '';
    const today = `${get('year')}-${get('month')}-${get('day')}`;
    const hm = `${get('hour')}:${get('minute')}`;
    let current = -1;
    if (today === '2026-10-30') slots.forEach((el, i) => el.dataset.time! <= hm && (current = i));
    if (hm >= '22:45') current = -1;
    slots.forEach((el, i) => el.querySelector('[data-now]')?.classList.toggle('hidden', i !== current));
  }
  markNow();
  setInterval(markNow, 30000);
</script>
