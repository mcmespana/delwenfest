---
import { Image } from 'astro:assets';
import sinbikini from '../assets/brand/sinbikini.webp';
import rodhel from '../assets/brand/rodhel-show.webp';
import micro from '../assets/illus/micro.webp';
---

<section id="musica" class="relative overflow-hidden bg-ink px-4 py-28 text-cream sm:px-8 md:py-36" data-lineup>
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute top-0 left-1/4 h-[120%] w-40 origin-top rotate-[18deg] bg-[linear-gradient(180deg,rgba(245,181,11,.35),transparent_70%)] blur-xl" data-beam></div>
    <div class="absolute top-0 right-1/4 h-[120%] w-40 origin-top -rotate-[18deg] bg-[linear-gradient(180deg,rgba(142,92,240,.4),transparent_70%)] blur-xl" data-beam></div>
    <div class="absolute top-0 left-1/2 h-[120%] w-32 origin-top bg-[linear-gradient(180deg,rgba(31,179,176,.3),transparent_70%)] blur-xl" data-beam></div>
  </div>

  <div class="relative mx-auto max-w-7xl">
    <div class="text-center">
      <p class="eyebrow text-gold" data-reveal="up">Música en directo</p>
      <h2 class="section-title mt-3" data-split>Line&#8209;up</h2>
    </div>

    <div class="mt-16 grid gap-8 md:grid-cols-2 md:gap-10">
      <!-- Sinbikini -->
      <article class="group relative overflow-hidden rounded-[2.25rem] border-[3px] border-cream bg-cream p-8 text-ink shadow-[8px_8px_0_0_#f5b50b] sm:p-10" data-act>
        <div class="flex items-center justify-between">
          <span class="font-display rounded-full bg-ink px-4 pt-2 pb-1.5 text-lg text-gold">19:00</span>
          <span class="eyebrow">Concierto</span>
        </div>
        <div class="relative mx-auto mt-6 w-[78%] max-w-sm">
          <Image src={sinbikini} alt="Sinbikini · Fresh music based on Mediterranean beach" widths={[400, 800]} sizes="(min-width: 768px) 30vw, 70vw" class="h-auto w-full transition-transform duration-700 ease-[var(--ease-bounce)] group-hover:rotate-[8deg] group-hover:scale-105" />
        </div>
        <Image src={micro} alt="" widths={[200, 400]} sizes="160px" class="pointer-events-none absolute -right-6 -bottom-6 w-36 rotate-12 opacity-90 sm:w-44" data-act-deco />
        <h3 class="font-display mt-6 text-5xl uppercase sm:text-6xl">Sinbikini</h3>
        <p class="mt-2 max-w-sm text-lg font-semibold">Fresh music based on Mediterranean beach. Música en directo para encender la noche.</p>
        <div class="mt-6 flex h-10 items-end gap-1.5" aria-hidden="true">
          {Array.from({ length: 18 }).map((_, i) => <span class="w-full origin-bottom rounded-t-sm bg-ink" style={`height:${30 + ((i * 37) % 70)}%`} data-eq style={`animation-delay:${-((i * 0.137) % 1).toFixed(2)}s; animation-duration:${(0.5 + ((i * 7) % 5) / 10).toFixed(2)}s`} />)}
        </div>
      </article>

      <!-- Rodhel Show -->
      <article class="group relative overflow-hidden rounded-[2.25rem] border-[3px] border-cream bg-[radial-gradient(120%_120%_at_100%_0%,#8e5cf0_0%,#f0437a_45%,#f87341_100%)] p-8 shadow-[8px_8px_0_0_#1fb3b0] sm:p-10" data-act>
        <div class="flex items-center justify-between">
          <span class="font-display rounded-full bg-ink px-4 pt-2 pb-1.5 text-lg text-gold">20:30</span>
          <span class="eyebrow">DJ set</span>
        </div>
        <div class="relative mx-auto mt-6 grid aspect-square w-[72%] max-w-xs place-items-center">
          <!-- Vinilo girando -->
          <div class="absolute inset-0 rounded-full bg-[repeating-radial-gradient(circle,#1a1816_0_2px,#2b2825_2px_5px)] shadow-[0_20px_60px_rgba(0,0,0,.45)] animate-spin [animation-duration:3.2s]" data-vinyl>
            <div class="absolute inset-[34%] rounded-full bg-[conic-gradient(#f5b50b,#f87341,#f7363a,#8cc63f,#f5b50b)]"></div>
            <div class="absolute inset-[47%] rounded-full bg-ink"></div>
            <div class="absolute inset-0 rounded-full bg-[conic-gradient(from_30deg,transparent_0deg,rgba(255,255,255,.14)_40deg,transparent_80deg,transparent_180deg,rgba(255,255,255,.1)_220deg,transparent_260deg)]"></div>
          </div>
          <Image src={rodhel} alt="Rodhel Show" widths={[500, 1000]} sizes="(min-width: 768px) 30vw, 70vw" class="relative z-10 h-auto w-[115%] max-w-none -rotate-6 drop-shadow-[5px_5px_0_rgba(36,33,30,.7)] transition-transform duration-500 ease-[var(--ease-bounce)] group-hover:scale-110 group-hover:rotate-3" />
        </div>
        <h3 class="font-display mt-6 text-5xl uppercase sm:text-6xl">Rodhel Show <span class="text-gold">DJ</span></h3>
        <p class="mt-2 max-w-sm text-lg font-semibold">A los platos desde las 20:30 hasta el cierre a las 22:30. Nadie se queda sentado.</p>
        <div class="mt-6 flex h-10 items-end gap-1.5" aria-hidden="true">
          {Array.from({ length: 18 }).map((_, i) => <span class="w-full origin-bottom rounded-t-sm bg-cream" style={`height:${30 + ((i * 53) % 70)}%`} data-eq style={`animation-delay:${-((i * 0.137) % 1).toFixed(2)}s; animation-duration:${(0.5 + ((i * 7) % 5) / 10).toFixed(2)}s`} />)}
        </div>
      </article>
    </div>
  </div>
</section>

<script>
  import { gsap, reduceMotion } from '../scripts/motion';

  if (!reduceMotion) {
    gsap.from('[data-act]', {
      y: 140,
      rotate: (i: number) => (i ? 7 : -7),
      opacity: 0,
      duration: 1.1,
      stagger: 0.15,
      ease: 'back.out(1.3)',
      scrollTrigger: { trigger: '[data-act]', start: 'top 85%', once: true },
    });
  }
</script>

<style>
  [data-eq] {
    animation: eq 0.6s ease-in-out infinite alternate;
  }
  @keyframes eq {
    from {
      transform: scaleY(0.2);
    }
    to {
      transform: scaleY(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-eq],
    [data-vinyl] {
      animation: none !important;
    }
  }
</style>
