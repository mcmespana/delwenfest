---
import { MEMBERSHIP, DELWENDE_URLS } from '../data/delwende';

const steps = [
  { n: '1', title: 'Elige tu cuota', text: 'La que te encaje: aquí abajo ves lo que te cuesta de verdad.' },
  { n: '2', title: 'Rellena el formulario', text: 'En la web de Delwende, con tu NIF para la deducción.' },
  { n: '3', title: 'Dilo en la puerta', text: 'Si te haces socio/a, cuéntanoslo en la entrada del DelwenFest.' },
];
---

<section id="socio" class="relative overflow-hidden bg-mint px-4 py-28 sm:px-8 md:py-36">
  <div class="paper-texture"></div>
  <div class="relative mx-auto max-w-7xl">
    <div class="grid gap-14 lg:grid-cols-[1fr_1.05fr] lg:gap-16">
      <div>
        <p class="eyebrow text-forest" data-reveal="up">Súmate todo el año</p>
        <h2 class="section-title mt-3" data-split>Hazte<br /><span class="text-pop">socio/a</span></h2>
        <p class="mt-6 max-w-lg text-lg leading-snug font-semibold sm:text-xl" data-reveal="up">{MEMBERSHIP.intro}</p>

        <ol class="mt-10 flex flex-col gap-4">
          {
            steps.map((s) => (
              <li class="sticker flex items-start gap-5 rounded-[1.5rem] bg-cream p-5" data-reveal="up">
                <span class="font-display grid size-12 shrink-0 place-items-center rounded-full bg-ink text-xl text-gold">{s.n}</span>
                <span>
                  <span class="block font-display text-xl uppercase">{s.title}</span>
                  <span class="mt-1 block leading-snug font-medium text-ink/75">{s.text}</span>
                </span>
              </li>
            ))
          }
        </ol>

        <ul class="mt-8 flex flex-col gap-2.5" data-reveal="up">
          {
            MEMBERSHIP.perks.map((p) => (
              <li class="flex items-start gap-3 text-lg leading-snug font-medium">
                <span class="mt-0.5 grid size-6 shrink-0 place-items-center rounded-full bg-forest text-cream">
                  <svg viewBox="0 0 24 24" class="size-3.5" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7" /></svg>
                </span>
                {p}
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Calculadora -->
      <div class="lg:sticky lg:top-28 lg:h-fit">
        <div class="sticker overflow-hidden rounded-[2rem] bg-cream" data-reveal="up" data-calc>
          <div class="bg-ink p-6 text-cream sm:p-8">
            <p class="eyebrow text-gold">Calculadora de desgravación</p>
            <p class="font-display mt-2 text-[clamp(1.7rem,3vw,2.4rem)] leading-[0.95] uppercase">¿Cuánto te cuesta de verdad?</p>
          </div>

          <div class="flex flex-col gap-6 p-6 sm:p-8">
            <div>
              <div class="flex items-baseline justify-between">
                <label for="cuota" class="font-display text-lg uppercase">Tu cuota</label>
                <p class="font-display text-3xl tabular-nums"><span data-out="cuota">{MEMBERSHIP.defaultAmount}</span> €<span class="text-base text-ink/50">/mes</span></p>
              </div>
              <div class="mt-3 flex flex-wrap gap-2">
                {
                  MEMBERSHIP.amounts.map((a) => (
                    <button type="button" class="calc-chip" data-amount={a} aria-pressed={a === MEMBERSHIP.defaultAmount ? 'true' : 'false'}>
                      {a} €
                    </button>
                  ))
                }
              </div>
              <input id="cuota" type="range" min="3" max="100" step="1" value={MEMBERSHIP.defaultAmount} class="calc-range mt-5 w-full" data-range />
            </div>

            <div class="rounded-[1.5rem] border-[3px] border-ink bg-gold p-5">
              <div class="flex h-4 overflow-hidden rounded-full border-2 border-ink bg-cream" aria-hidden="true">
                <div class="h-full bg-forest transition-[width] duration-500" data-bar-back></div>
                <div class="h-full flex-1 bg-coral"></div>
              </div>
              <dl class="mt-4 grid grid-cols-3 gap-3 text-center">
                <div>
                  <dt class="text-xs font-semibold tracking-wide uppercase opacity-70">Aportas al año</dt>
                  <dd class="font-display mt-1 text-2xl tabular-nums"><span data-out="anual">120</span> €</dd>
                </div>
                <div>
                  <dt class="text-xs font-semibold tracking-wide text-forest uppercase">Te devuelven</dt>
                  <dd class="font-display mt-1 text-2xl text-forest tabular-nums"><span data-out="deduccion">96</span> €</dd>
                </div>
                <div>
                  <dt class="text-xs font-semibold tracking-wide text-red uppercase">Te cuesta</dt>
                  <dd class="font-display mt-1 text-2xl text-red tabular-nums"><span data-out="coste">24</span> €</dd>
                </div>
              </dl>
              <p class="mt-5 text-center font-display text-lg leading-tight uppercase">
                Tu cuota de <span data-out="cuota2">10</span> € al mes te sale por
                <span class="mt-2 block">
                  <span class="inline-block -rotate-2 rounded-xl bg-ink px-4 pt-2 pb-1 text-[2.6rem] leading-none text-gold shadow-[4px_4px_0_0_#f7363a]"><span data-out="mes">2</span> € al mes</span>
                </span>
              </p>
            </div>

            <a href={DELWENDE_URLS.member} target="_blank" rel="noopener" class="btn btn-ink justify-center !py-4 !text-lg">Hazme socio/a en delwende.es <svg viewBox="0 0 24 24" class="inline size-[0.9em] -translate-y-px" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"></path></svg></a>

            <p class="text-xs leading-relaxed text-ink/60">
              Cálculo orientativo para particulares según la Ley 49/2002 de mecenazgo: se deduce el 80 % de los primeros 250 € al año y el 40 % del resto, con el límite del 10 % de la base liquidable. Para empresas la deducción es distinta.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Recordatorio para la puerta -->
    <div class="sticker mt-14 flex flex-col items-start gap-4 rounded-[2rem] bg-ink p-6 text-cream sm:flex-row sm:items-center sm:p-8" data-reveal="up">
      <span class="grid size-14 shrink-0 place-items-center rounded-full bg-gold text-ink">
        <svg viewBox="0 0 24 24" class="size-7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 4h3a2 2 0 0 1 2 2v14"></path><path d="M2 20h3"></path><path d="M13 20h9"></path><path d="M10 12v.01"></path><path d="M13 4.56v16.18a1 1 0 0 1-1.24.97L5 20V5.56a2 2 0 0 1 1.52-1.94l4-1A2 2 0 0 1 13 4.56Z"></path></svg>
      </span>
      <p class="font-display text-[clamp(1.4rem,2.6vw,2rem)] leading-[1.05] uppercase">
        ¿Te has hecho socio/a? <span class="text-gold">¡No te olvides de decirlo en la puerta!</span>
      </p>
      <a href="/hazte-socio" class="btn btn-gold shrink-0 !text-base sm:ml-auto">Cuéntanoslo aquí →</a>
    </div>
  </div>
</section>

<style>
  .calc-chip {
    border: 2.5px solid var(--color-ink);
    border-radius: 999px;
    padding: 0.45rem 1rem 0.3rem;
    background: white;
    font-family: var(--font-display);
    font-size: 1.05rem;
    transition:
      transform 0.25s var(--ease-bounce),
      box-shadow 0.25s var(--ease-bounce),
      background-color 0.2s;
  }
  .calc-chip[aria-pressed='true'] {
    background: var(--color-gold);
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-hard-sm);
  }
  .calc-range {
    appearance: none;
    height: 10px;
    border-radius: 999px;
    border: 2.5px solid var(--color-ink);
    background: linear-gradient(90deg, var(--color-gold) var(--p, 7%), white var(--p, 7%));
  }
  .calc-range::-webkit-slider-thumb {
    appearance: none;
    width: 28px;
    height: 28px;
    border-radius: 999px;
    background: var(--color-ink);
    border: 4px solid var(--color-gold);
    box-shadow: 2px 2px 0 var(--color-ink);
    cursor: grab;
  }
  .calc-range::-moz-range-thumb {
    width: 22px;
    height: 22px;
    border-radius: 999px;
    background: var(--color-ink);
    border: 4px solid var(--color-gold);
    cursor: grab;
  }
</style>

<script>
  const calc = document.querySelector<HTMLElement>('[data-calc]')!;
  const range = calc.querySelector<HTMLInputElement>('[data-range]')!;
  const chips = Array.from(calc.querySelectorAll<HTMLButtonElement>('[data-amount]'));
  const barBack = calc.querySelector<HTMLElement>('[data-bar-back]')!;
  const out = (k: string) => calc.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
  const eur = (n: number, dec = 0) => n.toLocaleString('es-ES', { minimumFractionDigits: dec, maximumFractionDigits: dec });
  const min = Number(range.min);
  const max = Number(range.max);

  /** Deducción anual de un particular (Ley 49/2002, porcentajes vigentes desde 2024). */
  const deduction = (annual: number) => Math.min(annual, 250) * 0.8 + Math.max(0, annual - 250) * 0.4;

  function update() {
    const cuota = Number(range.value);
    const anual = cuota * 12;
    const ded = deduction(anual);
    out('cuota').textContent = String(cuota);
    out('cuota2').textContent = String(cuota);
    out('anual').textContent = eur(anual);
    out('deduccion').textContent = eur(ded);
    out('coste').textContent = eur(anual - ded);
    const mes = (anual - ded) / 12;
    out('mes').textContent = eur(mes, Number.isInteger(Math.round(mes * 100) / 100) ? 0 : 2);
    range.style.setProperty('--p', `${((cuota - min) / (max - min)) * 100}%`);
    chips.forEach((c) => c.setAttribute('aria-pressed', String(Number(c.dataset.amount) === cuota)));
    barBack.style.width = `${(ded / anual) * 100}%`;
  }

  range.addEventListener('input', update);
  chips.forEach((c) =>
    c.addEventListener('click', () => {
      range.value = c.dataset.amount!;
      update();
    }),
  );
  update();
</script>
