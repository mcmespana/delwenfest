---
import { CALENDAR, DIRECTIONS, EVENT, VENUE } from '../data/event';

const whatsappText = [
  '🎉 *DELWENFEST* · Festival solidario Delwende',
  '📅 Viernes 30 de octubre · 17:15 – 22:30',
  `📍 ${VENUE.name} (${VENUE.street})`,
  `🚪 ${VENUE.entrance}, ${VENUE.entranceHint}`,
  `🗺️ ${DIRECTIONS.google}`,
  `ℹ️ ${EVENT.url}`,
].join('\n');
const whatsapp = `https://wa.me/?text=${encodeURIComponent(whatsappText)}`;
---

<!-- Botón flotante -->
<button
  type="button"
  class="fixed right-4 bottom-[calc(1rem+env(safe-area-inset-bottom))] z-40 flex items-center gap-2.5 rounded-full border-[3px] border-ink bg-ink py-2.5 pr-5 pl-2.5 font-display text-base tracking-wide text-gold uppercase shadow-[4px_4px_0_0_#f5b50b] sm:right-6 sm:bottom-6"
  data-remind
  data-remind-fab
  style="transform: translateY(160%)"
  aria-label="Guardar un recordatorio del DELWENFEST"
>
  <span class="grid size-8 place-items-center rounded-full bg-gold text-ink">
    <svg viewBox="0 0 24 24" class="size-[18px]" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8a6 6 0 1 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path></svg>
  </span>
  Recuérdamelo
</button>

<dialog class="remind m-0 h-full max-h-none w-full max-w-none bg-transparent p-0 backdrop:bg-transparent" aria-labelledby="remind-title" data-remind-dialog>
  <div class="absolute inset-0 bg-ink/50" data-remind-backdrop></div>
  <div
    class="absolute inset-x-0 bottom-0 mx-auto w-full max-w-md overflow-hidden rounded-t-[2rem] border-[3px] border-b-0 border-ink bg-cream px-5 pt-3 pb-[calc(1.5rem+env(safe-area-inset-bottom))] sm:inset-y-0 sm:my-auto sm:h-fit sm:rounded-[2rem] sm:border-b-[3px] sm:px-7 sm:pt-7 sm:shadow-[10px_10px_0_0_#24211e]"
    data-remind-sheet
  >
    <div class="flex justify-center pb-2 sm:hidden"><span class="h-1.5 w-12 rounded-full bg-ink/25"></span></div>

    <header class="flex items-start justify-between gap-4">
      <div>
        <p class="eyebrow text-coral">Recordatorio</p>
        <h2 id="remind-title" class="font-display mt-1 text-[2.3rem] leading-[0.9] uppercase">Que no se<br />te pase</h2>
      </div>
      <button type="button" class="grid size-11 shrink-0 place-items-center rounded-full border-[3px] border-ink bg-cream shadow-[var(--shadow-hard-sm)]" aria-label="Cerrar" data-remind-close>
        <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
      </button>
    </header>

    <p class="mt-3 text-[0.95rem] font-semibold text-ink/75">Viernes 30 oct · 17:15 – 22:30 · {VENUE.entrance}</p>

    <div class="mt-5 flex flex-col gap-2.5">
      <a href={CALENDAR.ics} class="cal-btn" data-cal="apple">
        <svg viewBox="0 0 24 24" class="size-6" fill="currentColor" aria-hidden="true"><path d="M16.37 12.65c-.02-2.2 1.8-3.26 1.88-3.31-1.03-1.5-2.62-1.7-3.18-1.73-1.35-.14-2.64.8-3.33.8-.69 0-1.74-.78-2.86-.76-1.47.02-2.83.86-3.59 2.17-1.53 2.66-.39 6.6 1.1 8.76.73 1.06 1.6 2.24 2.73 2.2 1.1-.05 1.51-.71 2.84-.71 1.32 0 1.7.71 2.86.69 1.18-.02 1.93-1.07 2.65-2.13.84-1.22 1.18-2.41 1.2-2.47-.03-.01-2.3-.88-2.3-3.5ZM14.2 6.17c.6-.73 1.01-1.75.9-2.76-.87.04-1.92.58-2.54 1.31-.56.64-1.05 1.68-.92 2.67.97.08 1.96-.49 2.56-1.22Z"></path></svg>
        <span class="flex-1"><span class="block">Calendario del móvil</span><span class="cal-sub">Con aviso el día antes y 2 h antes</span></span>
      </a>
      <a href={CALENDAR.google} target="_blank" rel="noopener" class="cal-btn" data-cal="google">
        <svg viewBox="0 0 24 24" class="size-6" aria-hidden="true"><rect x="3" y="4" width="18" height="17" rx="3" fill="#fff" stroke="currentColor" stroke-width="2"></rect><path d="M3 9h18" stroke="currentColor" stroke-width="2"></path><text x="12" y="18.5" text-anchor="middle" font-size="8" font-weight="900" fill="#2f6bd8" font-family="Arial">30</text></svg>
        <span class="flex-1"><span class="block">Google Calendar</span><span class="cal-sub">Android y Gmail</span></span>
      </a>
      <a href={whatsapp} target="_blank" rel="noopener" class="cal-btn" data-cal="whatsapp">
        <svg viewBox="0 0 24 24" class="size-6 text-[#25d366]" fill="currentColor" aria-hidden="true"><path d="M12.04 2a9.9 9.9 0 0 0-8.5 14.96L2 22l5.2-1.5A9.93 9.93 0 1 0 12.04 2Zm5.8 14.12c-.25.69-1.45 1.32-2 1.36-.53.05-1.03.24-3.47-.72-2.93-1.16-4.79-4.16-4.94-4.35-.14-.2-1.18-1.57-1.18-3s.75-2.13 1.02-2.42c.26-.29.57-.36.77-.36h.55c.17 0 .41-.06.64.49.24.58.82 2 .89 2.15.07.14.12.31.02.5-.1.2-.14.31-.29.48-.14.17-.3.38-.43.51-.14.14-.29.3-.13.59.17.29.74 1.22 1.58 1.97 1.09.97 2 1.27 2.29 1.41.29.15.46.12.62-.07.17-.2.72-.84.91-1.13.2-.29.39-.24.65-.14.27.1 1.68.79 1.97.94.29.14.48.22.55.34.07.12.07.7-.18 1.38Z"></path></svg>
        <span class="flex-1"><span class="block">Envíatelo por WhatsApp</span><span class="cal-sub">O pásaselo a tu gente</span></span>
      </a>
    </div>

    <!-- Instalar como app: discreto -->
    <p class="mt-5 hidden text-center text-sm text-ink/60" data-install>
      <button type="button" class="underline decoration-ink/30 underline-offset-4 hover:text-ink" data-install-btn>Instalar como app</button>
    </p>
    <p class="mt-5 hidden text-center text-sm text-ink/60" data-install-ios>
      ¿Como app? Pulsa <strong>Compartir</strong> y «Añadir a pantalla de inicio».
    </p>
  </div>
</dialog>

<style>
  .remind:not([open]) {
    display: none;
  }
  .cal-btn {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    border: 2.5px solid var(--color-ink);
    border-radius: 1.1rem;
    background: white;
    padding: 0.85rem 1rem;
    font-family: var(--font-display);
    font-size: 1.1rem;
    line-height: 1.1;
    text-transform: uppercase;
    transition:
      transform 0.25s var(--ease-bounce),
      box-shadow 0.25s var(--ease-bounce);
  }
  .cal-btn:hover,
  .cal-btn[data-primary='true'] {
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-hard-sm);
  }
  .cal-btn[data-primary='true'] {
    order: -1;
    background: var(--color-gold);
  }
  .cal-sub {
    display: block;
    margin-top: 0.15rem;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: none;
    opacity: 0.6;
  }
</style>

<script>
  import { gsap, ScrollTrigger, lenis, reduceMotion } from '../scripts/motion';

  const dialog = document.querySelector<HTMLDialogElement>('[data-remind-dialog]')!;
  const sheet = dialog.querySelector<HTMLElement>('[data-remind-sheet]')!;
  const backdrop = dialog.querySelector<HTMLElement>('[data-remind-backdrop]')!;
  const fab = document.querySelector<HTMLElement>('[data-remind-fab]')!;
  const mobile = () => window.matchMedia('(max-width: 639px)').matches;

  // Destacamos el calendario que corresponde al dispositivo
  const ua = navigator.userAgent;
  const isIOS = /iPad|iPhone|iPod/.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
  const isApple = isIOS || /Macintosh/.test(ua);
  const isAndroid = /Android/i.test(ua);
  const primary = isApple ? 'apple' : isAndroid ? 'google' : null;
  if (primary) dialog.querySelector<HTMLElement>(`[data-cal="${primary}"]`)!.dataset.primary = 'true';

  // Instalar como app (PWA), sin protagonismo
  type InstallPrompt = Event & { prompt: () => Promise<void> };
  const standalone = window.matchMedia('(display-mode: standalone)').matches || (navigator as unknown as { standalone?: boolean }).standalone;
  let deferred: InstallPrompt | null = null;
  if (!standalone) {
    if (isIOS) dialog.querySelector('[data-install-ios]')!.classList.remove('hidden');
    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      deferred = e as InstallPrompt;
      dialog.querySelector('[data-install]')!.classList.remove('hidden');
    });
    dialog.querySelector('[data-install-btn]')!.addEventListener('click', async () => {
      await deferred?.prompt();
      deferred = null;
      dialog.querySelector('[data-install]')!.classList.add('hidden');
    });
  }

  function open() {
    if (dialog.open) return;
    dialog.showModal();
    lenis?.stop();
    if (reduceMotion) return;
    gsap.fromTo(backdrop, { opacity: 0 }, { opacity: 1, duration: 0.3 });
    gsap.fromTo(sheet, mobile() ? { yPercent: 100 } : { yPercent: 6, opacity: 0 }, { yPercent: 0, opacity: 1, duration: 0.5, ease: 'expo.out' });
  }

  function close() {
    if (!dialog.open) return;
    const done = () => {
      dialog.close();
      lenis?.start();
    };
    if (reduceMotion) return done();
    gsap.to(backdrop, { opacity: 0, duration: 0.25 });
    gsap.to(sheet, { ...(mobile() ? { yPercent: 100 } : { yPercent: 6, opacity: 0 }), duration: 0.3, ease: 'power2.in', onComplete: done });
  }

  document.querySelectorAll('[data-remind]').forEach((b) => b.addEventListener('click', open));
  dialog.querySelector('[data-remind-close]')!.addEventListener('click', close);
  backdrop.addEventListener('click', close);
  dialog.addEventListener('cancel', (e) => {
    e.preventDefault();
    close();
  });

  // Botón flotante: aparece al pasar la portada y se esconde al llegar al pie
  gsap.set(fab, { y: 0, yPercent: reduceMotion ? 0 : 160 });
  if (!reduceMotion) {
    let shown = false;
    ScrollTrigger.create({
      trigger: '[data-hero]',
      start: 'bottom 60%',
      endTrigger: 'footer',
      end: 'top bottom',
      onToggle(self) {
        if (self.isActive === shown) return;
        shown = self.isActive;
        gsap.to(fab, { yPercent: shown ? 0 : 160, duration: 0.5, ease: shown ? 'back.out(1.8)' : 'power3.in' });
      },
    });
  }
</script>
