---
/** Los cinco puntos de la Ley 49/2002 explicados para la mesa de socios. */
import { LEY49 } from '../../data/socios';

interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;
const colores = ['bg-lime', 'bg-gold', 'bg-coral', 'bg-teal', 'bg-pink'];
---

<div class:list={['@container', cls]}>
<ol class="grid gap-3 @3xl:grid-cols-2">
  {
    LEY49.map((p, i) => (
      <li class="flex items-start gap-4 rounded-[1.25rem] @3xl:last:col-span-2 border-[3px] border-ink bg-white p-4 shadow-[var(--shadow-hard-sm)]">
        <span class={`grid size-10 shrink-0 place-items-center rounded-full border-[2.5px] border-ink ${colores[i]}`}>
          <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12l5 5L20 7" />
          </svg>
        </span>
        <span>
          <span class="font-display block text-[1.25rem] leading-tight uppercase">{p.title}</span>
          <span class="mt-1 block text-[1.05rem] leading-snug font-medium text-ink/80">{p.text}</span>
        </span>
      </li>
    ))
  }
</ol>
</div>
