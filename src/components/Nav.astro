---
import { Image } from 'astro:assets';
import delwen from '../assets/brand/delwen.webp';
import fest from '../assets/brand/fest.webp';

const links = [
  { href: '#plan', label: 'El plan' },
  { href: '#horario', label: 'Horario' },
  { href: '#lugar', label: 'Lugar' },
  { href: '#proyecto', label: 'El proyecto' },
  { href: '#delwende', label: 'Delwende' },
  { href: '#socio', label: 'Hazte socio' },
  { href: '#colaboradores', label: 'Colaboradores' },
];
---

<div
  class="pointer-events-none fixed inset-x-0 top-0 z-[60] h-1.5 origin-left scale-x-0 bg-[linear-gradient(90deg,#8cc63f,#f5c40b,#f87341,#f7363a)]"
  data-progress
  aria-hidden="true"
>
</div>

<header class="fixed inset-x-0 top-3 z-50 px-3 sm:top-4 sm:px-6" data-nav>
  <nav
    class="sticker mx-auto flex max-w-6xl items-center justify-between gap-3 rounded-full bg-cream/90 py-2 pr-2 pl-4 backdrop-blur-md sm:pl-5"
    aria-label="Principal"
  >
    <a href="#top" class="group relative flex h-9 items-center" aria-label="DELWENFEST, volver arriba" data-scroll>
      <span class="relative block h-full w-[124px] transition-transform duration-300 ease-[var(--ease-bounce)] group-hover:-rotate-3 group-hover:scale-105">
        <Image src={delwen} alt="" class="absolute top-0 left-0 h-full w-auto" widths={[160, 320]} sizes="90px" loading="eager" />
        <Image src={fest} alt="" class="absolute top-0 right-0 h-[95%] w-auto" widths={[100, 200]} sizes="52px" loading="eager" />
      </span>
    </a>

    <ul class="hidden items-center gap-0.5 xl:flex">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              data-scroll
              data-navlink={l.href.slice(1)}
              class="font-display relative rounded-full px-3.5 py-2 text-[0.95rem] tracking-wide uppercase transition-colors hover:bg-ink hover:text-cream data-[active=true]:bg-gold"
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <a href="#lugar" data-scroll class="btn btn-ink hidden !py-2.5 !text-base sm:inline-flex">
        <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true"
          ><path d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z"
          ></path></svg
        >
        Cómo llegar
      </a>
      <button
        type="button"
        class="sticker relative grid size-11 place-items-center rounded-full bg-gold !shadow-[var(--shadow-hard-sm)] xl:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="menu-movil"
        data-menu-btn
      >
        <span class="absolute h-[3px] w-5 -translate-y-1.5 rounded bg-ink transition-transform duration-300" data-bar1></span>
        <span class="absolute h-[3px] w-5 rounded bg-ink transition-opacity duration-200" data-bar2></span>
        <span class="absolute h-[3px] w-5 translate-y-1.5 rounded bg-ink transition-transform duration-300" data-bar3></span>
      </button>
    </div>
  </nav>
</header>

<div
  id="menu-movil"
  class="invisible fixed inset-0 z-40 flex flex-col justify-center bg-ink px-8 text-cream xl:hidden"
  data-menu
  aria-hidden="true"
>
  <div class="paper-texture !opacity-10"></div>
  <ul class="relative flex flex-col gap-2 [counter-reset:menu]">
    {
      links.map((l) => (
        <li class="overflow-hidden [counter-increment:menu]">
          <a
            href={l.href}
            data-scroll
            data-menu-link
            class="font-display block py-1 text-[clamp(2.6rem,12vw,4.5rem)] leading-none uppercase transition-colors hover:text-gold"
          >
            <span class="mr-3 align-top text-base text-gold before:content-[counter(menu,decimal-leading-zero)]" />
            {l.label}
          </a>
        </li>
      ))
    }
  </ul>
  <a href="#lugar" data-scroll data-menu-link class="btn btn-gold relative mt-10 self-start text-ink">Cómo llegar →</a>
</div>

<script>
  import { gsap, ScrollTrigger, lenis, scrollToTarget, reduceMotion } from '../scripts/motion';

  // Barra de progreso de scroll
  const bar = document.querySelector<HTMLElement>('[data-progress]');
  if (bar) {
    gsap.to(bar, {
      scaleX: 1,
      ease: 'none',
      scrollTrigger: { start: 0, end: 'max', scrub: 0.3 },
    });
  }

  // Ocultar la nav al bajar y mostrarla al subir
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  if (nav && !reduceMotion) {
    gsap.from(nav, { yPercent: -160, duration: 1, ease: 'expo.out', delay: 1.1 });
    let hidden = false;
    ScrollTrigger.create({
      start: 120,
      end: 'max',
      onUpdate(self) {
        const shouldHide = self.direction === 1 && self.scroll() > 400;
        if (shouldHide !== hidden) {
          hidden = shouldHide;
          gsap.to(nav, { yPercent: hidden ? -160 : 0, duration: 0.5, ease: 'power3.out' });
        }
      },
    });
  }

  // Enlace activo según la sección visible
  document.querySelectorAll<HTMLElement>('[data-navlink]').forEach((link) => {
    const id = link.dataset.navlink!;
    const section = document.getElementById(id);
    if (!section) return;
    ScrollTrigger.create({
      trigger: section,
      start: 'top 50%',
      end: 'bottom 50%',
      onToggle: (self) => (link.dataset.active = String(self.isActive)),
    });
  });

  // Menú móvil
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const menuLinks = menu ? menu.querySelectorAll<HTMLElement>('[data-menu-link]') : [];
  let open = false;

  const tl = gsap.timeline({ paused: true });
  if (menu) {
    tl.set(menu, { visibility: 'visible' })
      .fromTo(menu, { clipPath: 'circle(0% at 92% 6%)' }, { clipPath: 'circle(150% at 92% 6%)', duration: 0.7, ease: 'power3.inOut' })
      .from(menuLinks, { yPercent: 120, rotate: 4, duration: 0.6, stagger: 0.06, ease: 'back.out(1.6)' }, '-=0.35');
  }

  function setMenu(next: boolean) {
    if (!btn || !menu) return;
    open = next;
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    menu.setAttribute('aria-hidden', String(!open));
    btn.querySelector('[data-bar1]')?.classList.toggle('!translate-y-0', open);
    btn.querySelector('[data-bar1]')?.classList.toggle('rotate-45', open);
    btn.querySelector('[data-bar3]')?.classList.toggle('!translate-y-0', open);
    btn.querySelector('[data-bar3]')?.classList.toggle('-rotate-45', open);
    btn.querySelector('[data-bar2]')?.classList.toggle('opacity-0', open);
    if (open) {
      lenis?.stop();
      tl.timeScale(1).play();
    } else {
      lenis?.start();
      tl.timeScale(1.6).reverse();
    }
  }

  btn?.addEventListener('click', () => setMenu(!open));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && open) setMenu(false);
  });

  // Anclas con scroll suave
  document.querySelectorAll<HTMLAnchorElement>('a[data-scroll]').forEach((a) => {
    a.addEventListener('click', (e) => {
      const href = a.getAttribute('href');
      if (!href?.startsWith('#')) return;
      e.preventDefault();
      const wasOpen = open;
      if (open) setMenu(false);
      const go = () => (href === '#top' ? (lenis ? lenis.scrollTo(0, { duration: 1.4 }) : window.scrollTo({ top: 0, behavior: 'smooth' })) : scrollToTarget(href));
      wasOpen ? setTimeout(go, 350) : go();
      history.replaceState(null, '', href === '#top' ? location.pathname : href);
    });
  });
</script>
