---
const words = ['Juegos', 'Food trucks', 'Bingo musical', 'Premios', 'Rifa', 'Música en directo', 'Rodhel Show DJ', 'Toro mecánico', 'Hinchables'];
const row = [...words, ...words];
---

<section class="relative z-20 -my-10 overflow-hidden py-16" aria-label="Actividades del festival">
  <div class="sticker -mx-4 -rotate-[3deg] bg-ink py-3 text-cream sm:py-4" data-marquee data-dir="1">
    <div class="flex w-max will-change-transform" data-track>
      {
        [0, 1].map(() => (
          <div class="flex shrink-0 items-center" aria-hidden="true">
            {row.map((w, i) => (
              <span class="font-display flex items-center px-4 text-[clamp(1.6rem,4vw,3.2rem)] leading-none uppercase sm:px-6">
                <span class={i % 3 === 0 ? 'text-gold' : i % 3 === 1 ? 'text-cream' : 'text-lime'}>{w}</span>
                <span class="ml-8 text-coral sm:ml-12">✦</span>
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>
  <div class="sticker -mx-4 mt-[-2.2rem] rotate-[2deg] bg-gold py-2 sm:py-3" data-marquee data-dir="-1">
    <div class="flex w-max will-change-transform" data-track>
      {
        [0, 1].map(() => (
          <div class="flex shrink-0 items-center" aria-hidden="true">
            {row.map((w) => (
              <span class="font-condensed flex items-center px-4 text-[clamp(1.4rem,3vw,2.4rem)] leading-none tracking-wide uppercase sm:px-6">
                {w}
                <span class="ml-8 text-red sm:ml-12">●</span>
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>
  <p class="sr-only">{words.join(', ')}</p>
</section>

<script>
  import { gsap, ScrollTrigger, reduceMotion } from '../scripts/motion';

  if (!reduceMotion) {
    const tweens = gsap.utils.toArray<HTMLElement>('[data-marquee]').map((m) => {
      const dir = Number(m.dataset.dir);
      const track = m.querySelector('[data-track]')!;
      return gsap.fromTo(track, { xPercent: dir > 0 ? 0 : -50 }, { xPercent: dir > 0 ? -50 : 0, duration: 38, ease: 'none', repeat: -1 });
    });
    // La velocidad reacciona al scroll y cambia de sentido al subir
    let current = 1;
    ScrollTrigger.create({
      onUpdate(self) {
        const v = gsap.utils.clamp(-6, 6, self.getVelocity() / 250);
        const target = (self.direction || 1) * (1 + Math.abs(v));
        if (Math.abs(target - current) < 0.05) return;
        current = target;
        tweens.forEach((t) => gsap.to(t, { timeScale: target, duration: 0.3, overwrite: true }));
        gsap.to(tweens, { timeScale: self.direction || 1, duration: 1.2, delay: 0.3, overwrite: false });
      },
    });
  }
</script>
