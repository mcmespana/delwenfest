---
import { Image } from 'astro:assets';
import delwen from '../assets/brand/delwen.webp';
import fest from '../assets/brand/fest.webp';
import badge from '../assets/brand/badge-consolacion.webp';
import balon from '../assets/illus/balon.webp';
import micro from '../assets/illus/micro.webp';
import bingo from '../assets/illus/bingo.webp';
import ticket from '../assets/illus/ticket.webp';
import confeti from '../assets/illus/confeti.webp';
import regalo from '../assets/illus/regalo.webp';
import { EVENT } from '../data/event';

// depth: cuánto reacciona al ratón y al scroll; pos: clases de colocación
const stickers = [
  { src: balon, alt: 'Balón', depth: 0.9, pos: 'left-[4%] top-[17%] w-[18vw] sm:left-[6%] sm:top-[20%] sm:w-[8.5vw]', rot: -12 },
  { src: micro, alt: 'Micrófono', depth: 0.6, pos: 'hidden sm:block left-[1.5%] top-[50%] w-[12vw]', rot: -8 },
  { src: bingo, alt: 'Bingo', depth: 1.1, pos: 'left-[6%] bottom-[7%] w-[17vw] sm:left-[15%] sm:bottom-[8%] sm:w-[7vw]', rot: -10 },
  { src: ticket, alt: 'Ticket de la rifa', depth: 0.8, pos: 'right-[3%] top-[16%] w-[22vw] sm:right-[7%] sm:top-[21%] sm:w-[10vw]', rot: 14 },
  { src: confeti, alt: 'Lanzador de confeti', depth: 1.2, pos: 'right-[2%] bottom-[16%] w-[20vw] sm:right-[3%] sm:bottom-[24%] sm:w-[10vw]', rot: 8 },
  { src: regalo, alt: 'Regalo', depth: 0.7, pos: 'hidden sm:block right-[17%] bottom-[6%] w-[6.5vw]', rot: -6 },
];
---

<section id="top" class="relative isolate flex min-h-[100svh] items-center justify-center overflow-hidden bg-mint bg-[radial-gradient(60%_50%_at_10%_0%,rgba(140,198,63,.35),transparent),radial-gradient(55%_50%_at_100%_100%,rgba(247,54,58,.22),transparent),radial-gradient(45%_40%_at_55%_45%,rgba(245,181,11,.28),transparent)]" data-hero>
  <div class="paper-texture"></div>

  <!-- Rayos de sol retro -->
  <div
    class="pointer-events-none absolute inset-0 -z-10 bg-[repeating-conic-gradient(from_0deg_at_50%_45%,rgba(255,255,255,.42)_0deg_7deg,transparent_7deg_15deg)] [mask-image:radial-gradient(circle_at_50%_45%,black_10%,transparent_75%)]"
    aria-hidden="true"
    data-rays
  >
  </div>

  <!-- Pegatinas flotantes -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    {
      stickers.map((s) => (
        <div class={`absolute ${s.pos}`} data-sticker data-depth={s.depth}>
          <div data-sticker-scroll>
          <div>
            <Image
              src={s.src}
              alt=""
              widths={[160, 320, 480]}
              sizes="(min-width: 640px) 12vw, 22vw"
              loading="eager"
              class="h-auto w-full drop-shadow-[6px_10px_0_rgba(36,33,30,.18)]"
              style={`transform: rotate(${s.rot}deg)`}
            />
          </div>
          </div>
        </div>
      ))
    }
  </div>

  <!-- Contenido -->
  <div class="relative z-10 flex w-full flex-col items-center px-4 pt-28 pb-24 text-center sm:pt-32" data-hero-content>
    <p
      class="sticker font-condensed inline-flex items-center gap-3 rounded-full bg-gold px-5 pt-2 pb-1 text-[clamp(1.35rem,3.4vw,2.6rem)] leading-none tracking-wide sm:gap-4 sm:px-7"
      data-hero-pill
    >
      <span>30 Octubre 2026</span>
      <span class="h-[0.9em] w-[3px] -translate-y-[2px] rounded bg-ink"></span>
      <span>17:15 – 22:30h</span>
    </p>

    <h1 class="relative mt-4 w-[min(94vw,1120px)] sm:mt-6" data-wordmark>
      <span class="sr-only">DELWENFEST</span>
      <span class="relative block aspect-[1191/337]" aria-hidden="true">
        <span class="absolute top-0 left-0 block w-[68.5%]" data-delwen>
          <Image src={delwen} alt="" widths={[600, 1000, 1600]} sizes="(min-width: 1200px) 770px, 65vw" loading="eager" fetchpriority="high" class="h-auto w-full" />
        </span>
        <span class="absolute top-[0.6%] left-[60.4%] block w-[39.6%]" data-fest>
          <Image src={fest} alt="" widths={[400, 700, 925]} sizes="(min-width: 1200px) 445px, 38vw" loading="eager" fetchpriority="high" class="h-auto w-full" />
        </span>
      </span>
      <span class="absolute -top-[16%] -right-[3%] block w-[17%] sm:-top-[22%] sm:-right-[6%] sm:w-[15%]" data-badge>
        <Image src={badge} alt="" widths={[200, 400]} sizes="15vw" loading="eager" class="h-auto w-full drop-shadow-[4px_6px_0_rgba(36,33,30,.25)]" />
      </span>
    </h1>

    <p class="mt-3 max-w-2xl text-[clamp(1.15rem,2.4vw,1.75rem)] leading-tight font-bold sm:mt-5" data-hero-tagline>
      El festival solidario de la <span class="whitespace-nowrap">ONGD Delwende</span> en <span class="whitespace-nowrap">Consolación Castellón</span>
    </p>

    <!-- Cuenta atrás -->
    <div class="mt-7 sm:mt-9" data-countdown data-start={EVENT.start} data-end={EVENT.end}>
      <p class="eyebrow mb-3 justify-center text-ink/80" data-cd-label>Faltan</p>
      <div class="flex items-start justify-center gap-2 sm:gap-4" data-cd-boxes>
        {
          [
            ['d', 'días'],
            ['h', 'horas'],
            ['m', 'min'],
            ['s', 'seg'],
          ].map(([k, label]) => (
            <div class="flex flex-col items-center gap-1.5" data-cd-box>
              <div class="sticker relative grid h-[clamp(3.6rem,9vw,5.6rem)] w-[clamp(3.8rem,10vw,6.2rem)] place-items-center overflow-hidden rounded-2xl bg-cream">
                <span class="absolute inset-x-0 top-1/2 h-px bg-ink/10" />
                <span class="font-display text-[clamp(2rem,5.4vw,3.4rem)] leading-none tabular-nums" data-cd={k}>
                  00
                </span>
              </div>
              <span class="font-display text-xs tracking-[0.18em] uppercase sm:text-sm">{label}</span>
            </div>
          ))
        }
      </div>
      <p class="font-display hidden text-[clamp(1.6rem,4vw,2.6rem)] uppercase" data-cd-live></p>
    </div>

    <div class="mt-8 flex justify-center sm:mt-10" data-hero-ctas>
      <a href="#plan" data-scroll class="btn btn-gold group !px-7 !py-4 !text-lg">
        Descúbrelo todo
        <svg viewBox="0 0 24 24" class="size-5 transition-transform duration-300 group-hover:translate-y-1" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12l7 7 7-7"></path></svg>
      </a>
    </div>
  </div>

</section>

<script>
  import { gsap, SplitText, reduceMotion, finePointer } from '../scripts/motion';

  const hero = document.querySelector<HTMLElement>('[data-hero]')!;

  /* ---------------- Cuenta atrás ---------------- */
  const cd = hero.querySelector<HTMLElement>('[data-countdown]')!;
  const start = new Date(cd.dataset.start!).getTime();
  const end = new Date(cd.dataset.end!).getTime();
  const els = {
    d: cd.querySelector<HTMLElement>('[data-cd="d"]')!,
    h: cd.querySelector<HTMLElement>('[data-cd="h"]')!,
    m: cd.querySelector<HTMLElement>('[data-cd="m"]')!,
    s: cd.querySelector<HTMLElement>('[data-cd="s"]')!,
  };
  const pad = (n: number) => String(n).padStart(2, '0');

  function setDigit(el: HTMLElement, value: string, animate: boolean) {
    if (el.textContent === value) return;
    el.textContent = value;
    if (animate && !reduceMotion) gsap.fromTo(el, { yPercent: -70, opacity: 0 }, { yPercent: 0, opacity: 1, duration: 0.45, ease: 'back.out(2)' });
  }

  let timer = 0;
  function tick(animate = true) {
    const now = Date.now();
    if (now >= start) {
      const live = now < end;
      cd.querySelector('[data-cd-boxes]')!.classList.add('hidden');
      cd.querySelector('[data-cd-label]')!.textContent = live ? 'Ahora mismo' : '30 · 10 · 2026';
      const liveEl = cd.querySelector<HTMLElement>('[data-cd-live]')!;
      liveEl.classList.remove('hidden');
      liveEl.textContent = live ? '¡Estamos de fiesta! 🎉' : '¡Gracias por sumar!';
      if (!live) window.clearInterval(timer);
      return;
    }
    let diff = Math.floor((start - now) / 1000);
    const d = Math.floor(diff / 86400);
    diff -= d * 86400;
    const h = Math.floor(diff / 3600);
    diff -= h * 3600;
    const m = Math.floor(diff / 60);
    const s = diff - m * 60;
    setDigit(els.d, pad(d), animate);
    setDigit(els.h, pad(h), animate);
    setDigit(els.m, pad(m), animate);
    setDigit(els.s, pad(s), animate);
  }
  tick(false);
  timer = window.setInterval(tick, 1000);

  /* ---------------- Entrada ---------------- */
  const delwenEl = hero.querySelector('[data-delwen]');
  const festEl = hero.querySelector('[data-fest]');
  const stickers = gsap.utils.toArray<HTMLElement>('[data-sticker]', hero);

  if (!reduceMotion) {
    const tagline = new SplitText(hero.querySelector('[data-hero-tagline]'), { type: 'words', mask: 'words' });

    const intro = gsap.timeline({ defaults: { ease: 'expo.out' }, delay: 0.15 });
    intro
      .from('[data-rays]', { opacity: 0, scale: 0.4, duration: 1.6 }, 0)
      .from('[data-hero-pill]', { y: -120, rotate: -8, opacity: 0, duration: 1.1, ease: 'elastic.out(1,0.6)' }, 0.1)
      .from(delwenEl, { xPercent: -130, rotate: -14, scale: 0.6, opacity: 0, duration: 1.2, ease: 'back.out(1.5)' }, 0.25)
      .from(festEl, { yPercent: -260, rotate: 18, opacity: 0, duration: 0.9, ease: 'bounce.out' }, 0.55)
      .from('[data-badge]', { scale: 0, rotate: -180, duration: 1, ease: 'back.out(2)' }, 1.0)
      .from(tagline.words, { yPercent: 110, duration: 0.8, stagger: 0.03 }, 1.0)
      .from(stickers, { scale: 0, rotate: () => gsap.utils.random(-60, 60), duration: 1, stagger: 0.07, ease: 'back.out(2)' }, 0.7)
      .from('[data-cd-box]', { y: 40, rotateX: -90, opacity: 0, duration: 0.8, stagger: 0.08, ease: 'back.out(1.8)' }, 1.2)
      .from('[data-cd-label]', { opacity: 0, y: 10, duration: 0.6 }, 1.2)
      .from('[data-hero-ctas] > *', { y: 30, opacity: 0, duration: 0.7, stagger: 0.1, ease: 'back.out(2)' }, 1.4);

    // Parallax con el ratón
    if (finePointer) {
      const movers = stickers.map((el) => {
        const depth = Number(el.dataset.depth ?? 1);
        return {
          depth,
          x: gsap.quickTo(el, 'x', { duration: 1.1, ease: 'power3.out' }),
          y: gsap.quickTo(el, 'y', { duration: 1.1, ease: 'power3.out' }),
        };
      });
      const wm = hero.querySelector<HTMLElement>('[data-wordmark]')!;
      const wmx = gsap.quickTo(wm, 'rotationY', { duration: 1.2, ease: 'power3.out' });
      const wmy = gsap.quickTo(wm, 'rotationX', { duration: 1.2, ease: 'power3.out' });
      gsap.set(wm, { transformPerspective: 1200 });
      hero.addEventListener('pointermove', (e) => {
        const nx = e.clientX / window.innerWidth - 0.5;
        const ny = e.clientY / window.innerHeight - 0.5;
        movers.forEach((m) => {
          m.x(nx * 70 * m.depth);
          m.y(ny * 50 * m.depth);
        });
        wmx(nx * 10);
        wmy(-ny * 8);
      });
    }

    // Parallax al hacer scroll: el contenido se queda atrás y las pegatinas salen volando
    const st = { trigger: hero, start: 'top top', end: 'bottom top', scrub: true };
    gsap.to('[data-hero-content]', { yPercent: 28, opacity: 0.2, ease: 'none', scrollTrigger: st });
    stickers.forEach((el) => {
      const depth = Number(el.dataset.depth ?? 1);
      gsap.to(el.querySelector('[data-sticker-scroll]'), {
        yPercent: -220 * depth,
        rotate: gsap.utils.random(-50, 50),
        ease: 'none',
        scrollTrigger: st,
      });
    });
  }

  (window as unknown as { __delwenReady: boolean }).__delwenReady = true;
</script>
