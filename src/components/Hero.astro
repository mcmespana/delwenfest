---
import { Image } from 'astro:assets';
import delwen from '../assets/brand/delwen.webp';
import fest from '../assets/brand/fest.webp';
import { EVENT, VENUE } from '../data/event';
---

<section
  id="top"
  class="relative isolate flex min-h-[100svh] flex-col overflow-hidden bg-night text-cream"
  data-hero
>
  <!-- Auroras con los colores del cartel -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute -top-[30%] -left-[15%] size-[70vmax] rounded-full bg-[radial-gradient(circle,rgba(140,198,63,.30),transparent_62%)]" data-aurora></div>
    <div class="absolute top-[10%] -right-[20%] size-[70vmax] rounded-full bg-[radial-gradient(circle,rgba(247,54,58,.26),transparent_62%)]" data-aurora></div>
    <div class="absolute -bottom-[40%] left-[20%] size-[70vmax] rounded-full bg-[radial-gradient(circle,rgba(245,181,11,.22),transparent_62%)]" data-aurora></div>
    <div class="absolute inset-0 bg-[radial-gradient(600px_circle_at_var(--mx,50%)_var(--my,40%),rgba(255,247,232,.07),transparent_60%)]" data-hero-spot></div>
    <!-- Retícula fina -->
    <div class="absolute inset-0 opacity-[0.07] [background-image:linear-gradient(to_right,#fff7e8_1px,transparent_1px),linear-gradient(to_bottom,#fff7e8_1px,transparent_1px)] [background-size:calc(100%/12)_calc(100%/8)] [mask-image:radial-gradient(ellipse_at_center,black_30%,transparent_75%)]"></div>
    <div class="grain absolute inset-0"></div>
    <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-b from-transparent to-night"></div>
  </div>

  <div class="relative mx-auto flex w-full max-w-7xl flex-1 flex-col px-4 pt-24 pb-6 sm:px-8 sm:pt-32 sm:pb-10" data-hero-content>
    <!-- Fila superior -->
    <div class="flex items-center justify-between gap-6 border-b border-cream/15 pb-4 text-[0.7rem] tracking-[0.28em] uppercase sm:text-xs" data-hero-meta>
      <p class="flex items-center gap-2.5">
        <span class="size-1.5 rounded-full bg-lime"></span>
        Festival solidario · ONGD Delwende
      </p>
      <p class="hidden text-cream/60 sm:block">Castellón de la Plana · Edición 2026</p>
    </div>

    <!-- Logotipo -->
    <div class="flex flex-1 flex-col items-center justify-center py-7 sm:py-10">
      <h1 class="relative w-[min(92vw,1080px,max(340px,calc((100svh-540px)*3.4)))]" data-wordmark>
        <span class="sr-only">DELWENFEST</span>
        <span
          class="pointer-events-none absolute inset-[-12%] -z-10 bg-[radial-gradient(closest-side,rgba(245,181,11,.22),transparent)] blur-2xl"
          aria-hidden="true"
          data-glow></span>
        <span class="relative block aspect-[1191/337]" aria-hidden="true">
          <span class="absolute top-0 left-0 block w-[68.5%]" data-delwen>
            <Image src={delwen} alt="" widths={[600, 1000, 1600]} sizes="(min-width: 1200px) 740px, 64vw" loading="eager" fetchpriority="high" class="h-auto w-full" />
          </span>
          <span class="absolute top-[0.6%] left-[60.4%] block w-[39.6%]" data-fest>
            <Image src={fest} alt="" widths={[400, 700, 925]} sizes="(min-width: 1200px) 430px, 37vw" loading="eager" fetchpriority="high" class="h-auto w-full" />
          </span>
        </span>
      </h1>

      <p class="mt-5 max-w-2xl text-center text-[clamp(1.05rem,2.1vw,1.65rem)] leading-snug font-medium text-cream/85 sm:mt-8" data-hero-tagline>
        Una tarde de música, juegos y comida en Castellón para abrir oportunidades a 85 jóvenes en Atakpamé&nbsp;(Togo).
      </p>
    </div>

    <!-- Datos clave + cuenta atrás -->
    <div class="grid grid-cols-2 gap-px overflow-hidden rounded-3xl border border-cream/15 bg-cream/15 lg:grid-cols-[1fr_1fr_1.4fr]" data-hero-info>
      <div class="bg-night/85 p-4 backdrop-blur sm:p-6">
        <p class="text-[0.68rem] tracking-[0.24em] text-cream/50 uppercase">Cuándo</p>
        <p class="font-display mt-2 text-[1.35rem] leading-none uppercase sm:text-[1.75rem]">{EVENT.weekday} 30 oct</p>
        <p class="mt-1.5 text-sm text-cream/60">2026</p>
      </div>
      <div class="bg-night/85 p-4 backdrop-blur sm:p-6">
        <p class="text-[0.68rem] tracking-[0.24em] text-cream/50 uppercase">Horario</p>
        <p class="font-display mt-2 text-[1.35rem] leading-none sm:text-[1.75rem]">17:15 — 22:30</p>
        <p class="mt-1.5 text-sm text-cream/60">Donativo {EVENT.donation}</p>
      </div>
      <div class="col-span-2 bg-night/85 p-4 backdrop-blur sm:p-6 lg:col-span-1">
        <p class="text-[0.68rem] tracking-[0.24em] text-cream/50 uppercase">Dónde</p>
        <p class="font-display mt-2 text-[1.35rem] leading-none uppercase sm:text-[1.75rem]">Consolación Castellón</p>
        <p class="mt-1.5 text-sm text-cream/60">{VENUE.entrance} · {VENUE.entranceHint}</p>
      </div>
      <div class="col-span-2 flex flex-col justify-between gap-4 bg-night/85 p-4 backdrop-blur sm:flex-row sm:items-center sm:p-6 lg:col-span-3">
        <div data-countdown data-start={EVENT.start} data-end={EVENT.end}>
          <p class="text-[0.68rem] tracking-[0.24em] text-cream/50 uppercase" data-cd-label>Faltan</p>
          <div class="mt-2 flex items-baseline gap-3 font-display tabular-nums" data-cd-boxes>
            {
              [
                ['d', 'd'],
                ['h', 'h'],
                ['m', 'm'],
                ['s', 's'],
              ].map(([k, u]) => (
                <p class="flex items-baseline gap-0.5">
                  <span class="inline-block min-w-[2ch] overflow-hidden text-[1.75rem] leading-none sm:text-[2rem]">
                    <span class="inline-block" data-cd={k}>00</span>
                  </span>
                  <span class="text-sm text-cream/50">{u}</span>
                </p>
              ))
            }
          </div>
          <p class="font-display mt-2 hidden text-2xl uppercase" data-cd-live></p>
        </div>
        <div class="flex shrink-0 gap-2.5">
          <button type="button" class="btn btn-gold flex-1 justify-center !py-3 !text-base sm:flex-none" data-remind>
            <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8a6 6 0 1 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path></svg>
            Recuérdamelo
          </button>
          <a href="#horario" data-scroll class="btn !border-cream/40 !bg-transparent !py-3 !text-base !text-cream !shadow-none hover:!border-cream">Horario</a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap, SplitText, reduceMotion, finePointer } from '../scripts/motion';

  const hero = document.querySelector<HTMLElement>('[data-hero]')!;

  /* ---------------- Cuenta atrás ---------------- */
  const cd = hero.querySelector<HTMLElement>('[data-countdown]')!;
  const start = new Date(cd.dataset.start!).getTime();
  const end = new Date(cd.dataset.end!).getTime();
  const els = {
    d: cd.querySelector<HTMLElement>('[data-cd="d"]')!,
    h: cd.querySelector<HTMLElement>('[data-cd="h"]')!,
    m: cd.querySelector<HTMLElement>('[data-cd="m"]')!,
    s: cd.querySelector<HTMLElement>('[data-cd="s"]')!,
  };
  const pad = (n: number) => String(n).padStart(2, '0');

  function setDigit(el: HTMLElement, value: string, animate: boolean) {
    if (el.textContent === value) return;
    el.textContent = value;
    if (animate && !reduceMotion) gsap.fromTo(el, { yPercent: 100 }, { yPercent: 0, duration: 0.5, ease: 'expo.out' });
  }

  let timer = 0;
  function tick(animate = true) {
    const now = Date.now();
    if (now >= start) {
      const live = now < end;
      cd.querySelector('[data-cd-boxes]')!.classList.add('hidden');
      cd.querySelector('[data-cd-label]')!.textContent = live ? 'Ahora mismo' : 'Edición 2026';
      const liveEl = cd.querySelector<HTMLElement>('[data-cd-live]')!;
      liveEl.classList.remove('hidden');
      liveEl.textContent = live ? 'Estamos de fiesta' : 'Gracias por sumar';
      if (!live) window.clearInterval(timer);
      return;
    }
    let diff = Math.floor((start - now) / 1000);
    const d = Math.floor(diff / 86400);
    diff -= d * 86400;
    const h = Math.floor(diff / 3600);
    diff -= h * 3600;
    const m = Math.floor(diff / 60);
    const s = diff - m * 60;
    setDigit(els.d, pad(d), animate);
    setDigit(els.h, pad(h), animate);
    setDigit(els.m, pad(m), animate);
    setDigit(els.s, pad(s), animate);
  }
  tick(false);
  timer = window.setInterval(tick, 1000);

  /* ---------------- Entrada ---------------- */
  if (!reduceMotion) {
    const tagline = new SplitText(hero.querySelector('[data-hero-tagline]'), { type: 'lines', mask: 'lines' });

    gsap
      .timeline({ defaults: { ease: 'expo.out' }, delay: 0.1 })
      .from('[data-hero-meta]', { opacity: 0, y: -12, duration: 1 }, 0)
      .fromTo('[data-delwen]', { clipPath: 'inset(100% 0 0 0)', yPercent: 18 }, { clipPath: 'inset(0% 0 0 0)', yPercent: 0, duration: 1.4 }, 0.15)
      .fromTo('[data-fest]', { clipPath: 'inset(100% 0 0 0)', yPercent: 18 }, { clipPath: 'inset(0% 0 0 0)', yPercent: 0, duration: 1.4 }, 0.32)
      .from('[data-glow]', { opacity: 0, scale: 0.7, duration: 2 }, 0.4)
      .from(tagline.lines, { yPercent: 105, duration: 1.1, stagger: 0.08 }, 0.7)
      .from('[data-hero-info] > *', { opacity: 0, y: 24, duration: 1, stagger: 0.07 }, 0.85);

    // Auroras a la deriva
    gsap.utils.toArray<HTMLElement>('[data-aurora]', hero).forEach((b, i) => {
      gsap.to(b, {
        x: () => gsap.utils.random(-140, 140),
        y: () => gsap.utils.random(-100, 100),
        scale: () => gsap.utils.random(0.85, 1.15),
        duration: gsap.utils.random(9, 14),
        ease: 'sine.inOut',
        repeat: -1,
        yoyo: true,
        repeatRefresh: true,
        delay: i * 0.5,
      });
    });

    // Foco que sigue al ratón e inclinación sutil del logotipo
    if (finePointer) {
      const wm = hero.querySelector<HTMLElement>('[data-wordmark]')!;
      gsap.set(wm, { transformPerspective: 1400 });
      const ry = gsap.quickTo(wm, 'rotationY', { duration: 1.4, ease: 'power3.out' });
      const rx = gsap.quickTo(wm, 'rotationX', { duration: 1.4, ease: 'power3.out' });
      hero.addEventListener('pointermove', (e) => {
        const r = hero.getBoundingClientRect();
        hero.style.setProperty('--mx', `${e.clientX - r.left}px`);
        hero.style.setProperty('--my', `${e.clientY - r.top}px`);
        ry((e.clientX / window.innerWidth - 0.5) * 6);
        rx(-(e.clientY / window.innerHeight - 0.5) * 5);
      });
    }

    // Al hacer scroll el logotipo se aleja y la portada se funde
    const st = { trigger: hero, start: 'top top', end: 'bottom top', scrub: true };
    gsap.to('[data-wordmark]', { scale: 0.86, yPercent: 30, opacity: 0.25, ease: 'none', scrollTrigger: st });
    gsap.to('[data-hero-info]', { yPercent: 20, opacity: 0, ease: 'none', scrollTrigger: { ...st, start: 'top+=10% top' } });
  }

  (window as unknown as { __delwenReady: boolean }).__delwenReady = true;
</script>
