---
/**
 * Bingo musical: pantalla del equipo (no sale en el menú ni en buscadores).
 * Tres pestañas: Canciones (número del bombo → canción de Spotify), Premios
 * (compartidos en la base de datos) y Guía (tiempos, empates, consejos y notas).
 */
import PanelLayout from '../layouts/PanelLayout.astro';
import { CANCIONES, PLAYLIST, TOTAL, enlaces } from '../data/canciones';

const canciones = CANCIONES.map((c) => ({ ...c, ...enlaces(c) }));

const tabs = [
  { id: 'canciones', label: 'Canciones', emoji: '🎵' },
  { id: 'premios', label: 'Premios', emoji: '🏆' },
  { id: 'guia', label: 'Guía', emoji: '📋' },
];

// Cartón de muestra para la cabecera (3 filas × 9 columnas, como los de 90).
const filas = [
  [3, null, 24, null, 45, 58, null, 71, null],
  [null, 17, null, 36, null, 59, 62, null, 88],
  [8, null, 29, null, 47, null, 66, 77, null],
];
const marcados = new Set([24, 45, 17, 59, 62, 8, 66]);
---

<PanelLayout title="Bingo musical" manifest="/bingo.webmanifest" theme="#24211e" bodyClass="bg-mint">
  <header class="relative overflow-hidden bg-ink px-4 pt-8 pb-10 text-cream sm:px-8">
    <div class="mx-auto flex max-w-5xl flex-wrap items-end justify-between gap-6">
      <div>
        <p class="eyebrow text-gold">DelwenFest · solo equipo</p>
        <h1 class="section-title mt-2 !text-[clamp(3rem,11vw,6rem)] text-cream">Bingo <span class="text-gold">musical</span></h1>
        <p class="mt-3 max-w-[46ch] text-lg text-cream/80">
          90 canciones, cartones de 15 números. Aquí se busca la canción de cada bola, se apuntan los premios y está la chuleta para que salga redondo.
        </p>
      </div>
      <div class="carton" aria-hidden="true">
        {
          filas.flat().map((n, i) =>
            n === null ? <span class="v" /> : <span class:list={[{ m: marcados.has(n) }]} style={`--d:${i}`}>{n}</span>,
          )
        }
      </div>
    </div>
  </header>

  <nav class="sticky top-0 z-40 border-b-3 border-ink bg-cream/95 px-3 py-2.5 backdrop-blur-md" aria-label="Secciones del bingo">
    <div class="mx-auto flex max-w-5xl items-center gap-2" role="tablist">
      {
        tabs.map((t) => (
          <a
            href={`#${t.id}`}
            role="tab"
            data-tab={t.id}
            class="font-display flex flex-1 items-center justify-center gap-1.5 rounded-full border-3 border-ink px-3 pt-2.5 pb-2 text-base tracking-wide uppercase transition-colors aria-selected:bg-ink aria-selected:text-gold sm:flex-none sm:px-5"
          >
            <span aria-hidden="true">{t.emoji}</span>
            {t.label}
          </a>
        ))
      }
      <span class="ml-auto hidden items-center gap-2 text-sm text-ink/70 sm:flex" data-sync>
        <span class="size-2.5 rounded-full bg-ink/30" data-sync-dot></span>
        <span data-sync-txt>Conectando…</span>
      </span>
    </div>
  </nav>

  <main class="mx-auto max-w-5xl px-4 pt-8 pb-24 sm:px-8">
    <!-- ============================ CANCIONES ============================ -->
    <section id="canciones" data-panel="canciones" class="panel">
      <div class="grid gap-6 lg:grid-cols-[1fr_1fr]">
        <div class="sticker rounded-[2rem] bg-cream p-5 sm:p-7">
          <label for="bola" class="eyebrow text-ink/70">Ha salido la bola…</label>
          <div class="mt-3 flex items-center gap-3">
            <button type="button" class="paso" data-paso="-1" aria-label="Número anterior">−</button>
            <input
              id="bola"
              type="text"
              inputmode="numeric"
              pattern="[0-9]*"
              maxlength="2"
              autocomplete="off"
              placeholder="00"
              class="bola-input"
              aria-describedby="resultado"
            />
            <button type="button" class="paso" data-paso="1" aria-label="Número siguiente">+</button>
          </div>

          <div id="resultado" class="mt-6" aria-live="polite">
            <p class="text-lg text-ink/60" data-vacio>Escribe el número y te digo qué canción poner.</p>
            <div class="hidden" data-ficha>
              <p class="pizza-aviso hidden" data-pizza>🍕 <span data-pizza-txt></span></p>
              <p class="font-display text-[clamp(2rem,6vw,2.8rem)] leading-[0.95] uppercase" data-titulo></p>
              <p class="mt-1 text-xl text-ink/70" data-artista></p>
              <p class="mt-2 hidden font-bold text-red" data-repetida></p>
              <p class="mt-2 hidden text-sm text-ink/60" data-busqueda>Sin enlace directo: abre la búsqueda en Spotify.</p>
              <div class="mt-5 flex flex-wrap items-center gap-3">
                <a class="btn btn-gold !text-xl" data-spotify target="_blank" rel="noopener">
                  <svg viewBox="0 0 24 24" class="size-6" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm4.6 14.4a.62.62 0 0 1-.86.2c-2.35-1.43-5.3-1.76-8.79-.96a.62.62 0 1 1-.28-1.21c3.81-.87 7.09-.5 9.72 1.11.3.18.39.57.2.86Zm1.22-2.72a.78.78 0 0 1-1.07.26c-2.69-1.65-6.79-2.13-9.97-1.17a.78.78 0 1 1-.45-1.49c3.63-1.1 8.15-.57 11.23 1.33.37.22.48.7.26 1.07Zm.1-2.83C14.7 8.94 9.37 8.76 6.3 9.7a.94.94 0 1 1-.55-1.8c3.53-1.07 9.4-.86 13.1 1.34a.94.94 0 0 1-.96 1.61Z"></path></svg>
                  Abrir en Spotify
                </a>
                <a class="text-sm underline decoration-2 underline-offset-4" data-spotify-app>Abrir en la app</a>
              </div>
            </div>
            <p class="hidden text-lg" data-falta>
              Aún no hay canción para el <b data-falta-n></b>. Falta añadirla a la lista.
            </p>
          </div>

          <div class="mt-6 border-t-2 border-dashed border-ink/20 pt-5">
            <button type="button" class="btn btn-ink w-full justify-center sm:w-auto" data-sonar disabled>
              <span data-sonar-txt>✓ Marcar como sonada</span>
            </button>
          </div>
        </div>

        <div class="sticker rounded-[2rem] bg-cream p-5 sm:p-7">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <p class="eyebrow text-ink/70">Han sonado</p>
            <p class="font-display text-3xl tabular-nums"><span data-cuenta>0</span><span class="text-ink/40"> / {TOTAL}</span></p>
          </div>
          <p class="mt-2 rounded-2xl bg-mint-light px-4 py-2.5 text-base" data-pista>Pulsa un número para ver su canción.</p>
          <div class="tablero mt-4" data-tablero role="group" aria-label="Números del 1 al 90">
            {
              Array.from({ length: TOTAL }, (_, i) => (
                <button type="button" data-n={i + 1} aria-pressed="false">
                  {i + 1}
                </button>
              ))
            }
          </div>
          <p class="mt-3 text-sm text-ink/60">Últimas: <span data-ultimas>—</span></p>
          <div class="mt-5 flex flex-wrap gap-3">
            <button type="button" class="btn btn-cream !py-2 !text-sm" data-nueva-partida>Nueva partida</button>
            <a class="btn btn-cream !py-2 !text-sm" href="/bingo-listado.pdf" target="_blank" rel="noopener">Listado para imprimir</a>
            {
              PLAYLIST && (
                <a class="btn btn-cream !py-2 !text-sm" href={PLAYLIST} target="_blank" rel="noopener">
                  Playlist completa
                </a>
              )
            }
          </div>
        </div>
      </div>

      <details class="sticker mt-6 rounded-[2rem] bg-cream p-5 sm:p-7">
        <summary class="font-display cursor-pointer text-xl uppercase">Lista completa ({canciones.length} de {TOTAL})</summary>
        {
          canciones.length === 0 ? (
            <p class="mt-3 text-ink/70">
              Todavía no hay canciones cargadas. Se añaden en <code>src/data/canciones.ts</code>.
            </p>
          ) : (
            <>
              <input type="search" placeholder="Buscar título o artista…" class="campo mt-4" data-filtro aria-label="Buscar canción" />
              <ol class="mt-3 divide-y-2 divide-dashed divide-ink/15" data-lista>
                {canciones.map((c) => (
                  <li class="flex items-center gap-3 py-2" data-item={`${c.n} ${c.titulo} ${c.artista}`.toLowerCase()}>
                    <button type="button" class="mini-bola" data-ir={c.n}>
                      {c.n}
                    </button>
                    <span class="min-w-0 flex-1">
                      <b>{c.titulo}</b> <span class="text-ink/60">· {c.artista}</span>
                    </span>
                    <a href={c.web} target="_blank" rel="noopener" class="text-sm underline underline-offset-4">
                      Spotify
                    </a>
                  </li>
                ))}
              </ol>
            </>
          )
        }
      </details>
    </section>

    <!-- ============================ PREMIOS ============================ -->
    <section id="premios" data-panel="premios" class="panel" hidden>
      <p class="text-lg text-ink/80">Lo que se escribe aquí se guarda solo y lo ve todo el equipo al momento.</p>

      <h2 class="font-display mt-8 text-3xl uppercase">Principales</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2" data-lista-premios="principal"></div>

      <h2 class="font-display mt-10 text-3xl uppercase">Pizzas 🍕</h2>
      <p class="mt-1 text-ink/70">Pon el número de la canción y, cuando salga esa bola, la pestaña de canciones avisará de que toca pizza.</p>
      <div class="mt-4 grid gap-4 sm:grid-cols-2" data-lista-premios="pizza"></div>

      <h2 class="font-display mt-10 text-3xl uppercase">Secundarios</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2" data-lista-premios="secundario"></div>
      <button type="button" class="btn btn-cream mt-5" data-nuevo-premio="secundario">+ Añadir premio secundario</button>
    </section>

    <!-- ============================ GUÍA ============================ -->
    <section id="guia" data-panel="guia" class="panel" hidden>
      <div class="sticker rounded-[2rem] bg-cream p-5 sm:p-7">
        <h2 class="font-display text-3xl uppercase">Notas del equipo</h2>
        <p class="mt-1 text-ink/70">Quién lleva el bombo, quién pone la música, la regla de empates… Se guarda solo.</p>
        <textarea class="campo mt-4 min-h-40" data-notas placeholder="Escribid aquí lo que haga falta recordar"></textarea>
        <p class="mt-1 text-sm text-ink/50" data-notas-estado></p>
      </div>

      <div class="sticker mt-6 rounded-[2rem] bg-cream p-5 sm:p-7">
        <h2 class="font-display text-3xl uppercase">¿Cuánto dura?</h2>
        <p class="mt-2">Cada canción ocupa el fragmento más la pausa para decir el número en voz alta. Solo hay que saber cuántas canciones hacen falta.</p>
        <p class="formula">Tiempo = <b>nº de canciones</b> × (fragmento + pausa)<br /><span class="text-ink/60">Ejemplo: 66 canciones × 25 s = 27,5 minutos</span></p>

        <div class="mt-5 flex flex-wrap items-end gap-x-8 gap-y-5">
          <div>
            <p class="mb-2 font-bold">Cartones en juego</p>
            <div class="segmento" role="group" aria-label="Cartones">
              <button type="button" data-cartones="100" aria-pressed="true">100</button>
              <button type="button" data-cartones="200" aria-pressed="false">200</button>
            </div>
          </div>
          <label class="block">
            <span class="mb-2 block font-bold">Fragmento <span class="font-display text-xl text-red" data-frag-v>20 s</span></span>
            <input type="range" min="10" max="40" step="5" value="20" data-frag class="w-56 accent-red" />
          </label>
          <label class="block">
            <span class="mb-2 block font-bold">Pausa para cantar el número <span class="font-display text-xl text-red" data-pausa-v>5 s</span></span>
            <input type="range" min="0" max="10" step="1" value="5" data-pausa class="w-56 accent-red" />
          </label>
        </div>

        <div class="mt-6 overflow-x-auto">
          <div class="tira" data-tira role="img" aria-label="Las 90 canciones: en coral la zona de las líneas, en rojo la del bingo"></div>
          <div class="flex min-w-[560px] justify-between text-sm text-ink/60"><span>canción 1</span><span>30</span><span>60</span><span>90</span></div>
        </div>
        <p class="mt-1 text-sm text-ink/60">Coral: zona habitual de las líneas. Rojo: zona habitual del bingo (8 de cada 10 partidas caen ahí).</p>
        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-hitos></div>

        <details class="mt-6 rounded-2xl border-2 border-dashed border-ink/25 p-4">
          <summary class="cursor-pointer font-bold">¿De dónde salen estos números?</summary>
          <p class="mt-3">Un cartón tiene 15 de las 90 canciones. Para cantar bingo tienen que haber sonado las 15. Si ya han sonado <i>t</i> canciones, la probabilidad de que un cartón concreto esté completo es:</p>
          <p class="formula">P(cartón completo) = C(t, 15) / C(90, 15)</p>
          <p class="mt-2">Con 66 canciones sonadas sale un 0,6 % para un cartón. Con 100 cartones, la probabilidad de que <i>al menos uno</i> haya cantado es 1 − (1 − 0,006)<sup>100</sup> ≈ <b>44 %</b>. Con 200 cartones, un 69 %.</p>
          <p class="mt-2">Por eso doblar los jugadores apenas adelanta 3 canciones: la probabilidad se dispara justo al final, entre la canción 60 y la 70.</p>
          <p class="mt-2">Las líneas y los empates salen de simular 20.000 partidas con cartones reales de 90.</p>
        </details>
      </div>

      <div class="mt-6 grid gap-6 lg:grid-cols-2">
        <div class="sticker rounded-[2rem] bg-cream p-5 sm:p-7">
          <h2 class="font-display text-3xl uppercase">¿Y si cantan dos a la vez?</h2>
          <p class="mt-2">Pasa más de lo que parece: varios cartones pueden estar esperando la misma última canción.</p>
          <div class="mt-4 overflow-x-auto">
            <table class="w-full text-left">
              <thead class="font-display uppercase"><tr><th></th><th class="py-2">100 cartones</th><th class="py-2">200 cartones</th></tr></thead>
              <tbody class="divide-y-2 divide-dashed divide-ink/15">
                <tr><td class="py-2 pr-3">Empate en la línea</td><td class="dato">1 de cada 13</td><td class="dato">1 de cada 11</td></tr>
                <tr><td class="py-2 pr-3">Empate en el bingo</td><td class="dato">1 de cada 9</td><td class="dato">1 de cada 9</td></tr>
                <tr><td class="py-2 pr-3">Empate de 3 o más</td><td>muy raro (1/70)</td><td>muy raro (1/70)</td></tr>
              </tbody>
            </table>
          </div>
          <p class="mt-3"><b>Decidid la regla antes de empezar y decidla en voz alta.</b> Opciones: repartir el premio, una canción de desempate (gana quien la diga primero) o premio de consolación para el segundo.</p>
        </div>

        <div class="sticker card-gold rounded-[2rem] p-5 sm:p-7">
          <h2 class="font-display text-3xl uppercase">Las 10 pizzas</h2>
          <p class="mt-2">Ojo: no suenan las 90 canciones. El bingo se canta hacia la 65, así que si eliges 10 canciones al azar <b>solo suenan unas 7</b>, y que suenen las 10 pasa 1 de cada 20 partidas.</p>
          <p class="mt-2"><b>Solución:</b> como el orden lo decidís vosotros, poned las 10 canciones de pizza <b>entre las primeras 50</b> de la lista, repartidas. El bingo prácticamente nunca sale antes de la canción 55, así que las pizzas están garantizadas y el bingo sigue siendo justo.</p>
        </div>
      </div>

      <div class="sticker mt-6 rounded-[2rem] bg-cream p-5 sm:p-7">
        <h2 class="font-display text-3xl uppercase">Para que salga redondo</h2>
        <ol class="consejos mt-3">
          <li><b>Fragmentos de 20 segundos.</b> El bingo dura unos 28 minutos. Con 30 segundos se va a casi 40 y el final se hace largo.</li>
          <li><b>Tras cada fragmento, decid el número en voz alta</b> («¡La 47!») y repetidlo. Sin proyector, es lo que mantiene a todos al día.</li>
          <li><b>Marcad cada número en la pestaña Canciones</b> (o en papel). Cuando alguien cante, se comprueba su cartón en segundos.</li>
          <li><b>Preparad la lista ya barajada</b>, con las pizzas entre las primeras 50, y no la mováis durante la partida.</li>
          <li><b>Después de cantar la línea, no paréis mucho</b>: la 2.ª y la 3.ª línea llegan solo 5 y 8 canciones más tarde.</li>
        </ol>
      </div>
    </section>
  </main>

  <p class="toast" data-toast role="status" aria-live="polite"></p>

  <script type="application/json" id="canciones-data" set:html={JSON.stringify(canciones).replace(/</g, '\\u003c')} />
</PanelLayout>

<script>
  import '../scripts/bingo';
</script>

<style>
  .carton {
    display: grid;
    grid-template-columns: repeat(9, 1fr);
    gap: 3px;
    width: min(100%, 380px);
    padding: 5px;
    border: 3px solid var(--color-cream);
    border-radius: 14px;
    background: var(--color-cream);
    box-shadow: 6px 6px 0 var(--color-gold);
    transform: rotate(-2deg);
  }
  .carton span {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1 / 1.05;
    border: 1.5px solid rgb(36 33 30 / 0.2);
    border-radius: 4px;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: clamp(0.85rem, 3vw, 1.2rem);
  }
  .carton span.v {
    border-color: transparent;
    background: var(--color-mint-light);
  }
  .carton span.m::after {
    content: '';
    position: absolute;
    inset: 12%;
    border-radius: 50%;
    background: var(--color-red);
    opacity: 0.75;
    mix-blend-mode: multiply;
    animation: marca 0.35s var(--ease-bounce) backwards;
    animation-delay: calc(var(--d) * 50ms);
  }
  @keyframes marca {
    from {
      transform: scale(1.8);
      opacity: 0;
    }
  }

  .paso {
    display: grid;
    flex: none;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border: 3px solid var(--color-ink);
    border-radius: 999px;
    background: var(--color-mint-light);
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1;
    box-shadow: var(--shadow-hard-sm);
  }
  .paso:active {
    transform: translate(2px, 2px);
    box-shadow: none;
  }
  .bola-input {
    width: 100%;
    min-width: 0;
    border: 3px solid var(--color-ink);
    border-radius: 999px;
    background: var(--color-gold);
    padding: 0.3rem 0.5rem 0;
    text-align: center;
    font-family: var(--font-display);
    font-size: clamp(4rem, 16vw, 6.5rem);
    line-height: 1.05;
    font-variant-numeric: tabular-nums;
    box-shadow: var(--shadow-hard);
  }
  .bola-input::placeholder {
    color: rgb(36 33 30 / 0.25);
  }
  .bola-input:focus {
    outline: 4px solid var(--color-red);
    outline-offset: 3px;
  }

  .pizza-aviso {
    display: inline-block;
    margin-bottom: 0.75rem;
    border: 3px solid var(--color-ink);
    border-radius: 999px;
    background: var(--color-red);
    padding: 0.4rem 1rem 0.25rem;
    color: var(--color-cream);
    font-family: var(--font-display);
    font-size: 1.15rem;
    text-transform: uppercase;
    box-shadow: var(--shadow-hard-sm);
    animation: wiggle 1.6s ease-in-out infinite;
  }
  .pizza-aviso.hidden {
    display: none;
  }

  .tablero {
    display: grid;
    grid-template-columns: repeat(10, 1fr);
    gap: 4px;
  }
  .tablero button {
    aspect-ratio: 1;
    border: 2px solid rgb(36 33 30 / 0.25);
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: clamp(0.8rem, 2.6vw, 1.05rem);
    font-variant-numeric: tabular-nums;
    transition: background-color 0.15s, transform 0.2s var(--ease-bounce);
  }
  .tablero button[aria-pressed='true'] {
    border-color: var(--color-ink);
    background: var(--color-ink);
    color: var(--color-gold);
  }
  .tablero button[data-actual='true'] {
    outline: 3px solid var(--color-red);
    outline-offset: 1px;
    transform: scale(1.12);
  }
  .tablero button[data-pizza='true']:not([aria-pressed='true']) {
    border-color: var(--color-red);
    border-style: dashed;
  }

  .mini-bola {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border: 2px solid var(--color-ink);
    border-radius: 999px;
    background: var(--color-gold);
    font-family: var(--font-display);
  }

  .formula {
    margin-top: 1rem;
    border: 3px solid var(--color-ink);
    border-radius: 1rem;
    background: var(--color-mint-light);
    padding: 0.8rem 1rem;
    font-size: 1.1rem;
  }
  .formula b {
    color: var(--color-red);
  }

  .segmento {
    display: inline-flex;
    overflow: hidden;
    border: 3px solid var(--color-ink);
    border-radius: 999px;
  }
  .segmento button {
    padding: 0.5rem 1.1rem 0.35rem;
    font-family: var(--font-display);
    font-size: 1.1rem;
  }
  .segmento button[aria-pressed='true'] {
    background: var(--color-ink);
    color: var(--color-gold);
  }

  .tira {
    display: grid;
    grid-template-columns: repeat(90, minmax(5px, 1fr));
    min-width: 560px;
    height: 44px;
    overflow: hidden;
    border: 3px solid var(--color-ink);
    border-radius: 12px;
    background: var(--color-mint-light);
  }
  .tira :global(i) {
    border-right: 1px solid rgb(36 33 30 / 0.12);
  }
  .tira :global(i:nth-child(10n)) {
    border-right: 2px solid rgb(36 33 30 / 0.4);
  }
  .tira :global(i.l) {
    background: var(--color-amber);
  }
  .tira :global(i.b) {
    background: var(--color-red);
  }

  .dato {
