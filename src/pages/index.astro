---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Plan from '../components/Plan.astro';
import Horario from '../components/Horario.astro';
import LineUp from '../components/LineUp.astro';
import Lugar from '../components/Lugar.astro';
import Causa from '../components/Causa.astro';
import Delwende from '../components/Delwende.astro';
import Proyecto from '../components/Proyecto.astro';
import HazteSocio from '../components/HazteSocio.astro';
import Patrocinadores from '../components/Patrocinadores.astro';
import Footer from '../components/Footer.astro';
import Recordatorio from '../components/Recordatorio.astro';
---

<Layout>
  <Nav />
  <main>
    <Hero />
    <Marquee />
    <Plan />
    <Horario />
    <LineUp />
    <Lugar />
    <Causa />
    <!-- En borrador: solo visibles con ?borrador -->
    <Delwende />
    <Proyecto />
    <HazteSocio />
    <Patrocinadores />
  </main>
  <Footer />
  <Recordatorio />
</Layout>

<script>
  import '../scripts/reveal';
</script>
